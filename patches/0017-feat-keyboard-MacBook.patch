+package com.atharok.btremote.domain.entities.remoteInput.keyboard.mac
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class MacKeyboardPresentationPolicyTest {
+
+    @Test
+    fun wideBreakpointMatchesTheAppleReference() {
+        assertFalse(MacKeyboardPresentationPolicy.isWide(759f))
+        assertTrue(MacKeyboardPresentationPolicy.isWide(760f))
+        assertTrue(MacKeyboardPresentationPolicy.isWide(1024f))
+    }
+
+    @Test
+    fun compactPortraitKeepsHalfOfTheScreenHeight() {
+        val height = MacKeyboardPresentationPolicy.maxKeyboardHeight(
+            widthDp = 360f,
+            availableHeightDp = 500f,
+            screenHeightDp = 800f,
+            isPortrait = true
+        )
+
+        assertEquals(400f, height, 0.01f)
+    }
+
+    @Test
+    fun compactPortraitNeverExceedsTheAvailableHeight() {
+        val height = MacKeyboardPresentationPolicy.maxKeyboardHeight(
+            widthDp = 360f,
+            availableHeightDp = 300f,
+            screenHeightDp = 800f,
+            isPortrait = true
+        )
+
+        assertEquals(300f, height, 0.01f)
+    }
+
+    @Test
+    fun compactLandscapeUsesTheFullScreenHeight() {
+        val height = MacKeyboardPresentationPolicy.maxKeyboardHeight(
+            widthDp = 600f,
+            availableHeightDp = 500f,
+            screenHeightDp = 400f,
+            isPortrait = false
+        )
+
+        assertEquals(400f, height, 0.01f)
+    }
+
+    @Test
+    fun wideLayoutCapsHeightAgainstItsWidth() {
+        val height = MacKeyboardPresentationPolicy.maxKeyboardHeight(
+            widthDp = 1000f,
+            availableHeightDp = 700f,
+            screenHeightDp = 700f,
+            isPortrait = false
+        )
+
+        assertEquals(320f, height, 0.01f)
+    }
+
+    @Test
+    fun wideLayoutStillRespectsTheAvailableHeight() {
+        val height = MacKeyboardPresentationPolicy.maxKeyboardHeight(
+            widthDp = 1000f,
+            availableHeightDp = 200f,
+            screenHeightDp = 700f,
+            isPortrait = false
+        )
+
+        assertEquals(200f, height, 0.01f)
+    }
+
+    @Test
+    fun unboundedParentFallsBackToTheScreenHeight() {
+        assertEquals(
+            400f,
+            MacKeyboardPresentationPolicy.maxKeyboardHeight(
+                widthDp = 360f,
+                availableHeightDp = null,
+                screenHeightDp = 800f,
+                isPortrait = true
+            ),
+            0.01f
+        )
+        assertEquals(
+            400f,
+            MacKeyboardPresentationPolicy.maxKeyboardHeight(
+                widthDp = 600f,
+                availableHeightDp = null,
+                screenHeightDp = 400f,
+                isPortrait = false
+            ),
+            0.01f
+        )
+    }
+}
