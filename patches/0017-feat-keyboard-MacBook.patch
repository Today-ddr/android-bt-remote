+package com.atharok.btremote.domain.entities.remoteInput.keyboard.mac
+
+/**
+ * Sizing rules for the MacBook keyboard, mirroring the iOS client's FullKeyboardLayoutPolicy so
+ * the keyboard stays usable in portrait, narrow landscape and wide landscape.
+ */
+object MacKeyboardPresentationPolicy {
+
+    /** Wide layouts start where the iOS client splits keyboard and trackpad. */
+    const val WIDE_BREAKPOINT_DP = 760f
+
+    /** On a wide screen the keyboard keeps a MacBook-like aspect instead of stretching. */
+    const val WIDE_HEIGHT_TO_WIDTH_RATIO = 0.32f
+
+    /** In portrait the keyboard never takes more than half of the screen height. */
+    const val COMPACT_PORTRAIT_HEIGHT_RATIO = 0.5f
+
+    fun isWide(widthDp: Float): Boolean = widthDp >= WIDE_BREAKPOINT_DP
+
+    /**
+     * Returns the height budget of the keyboard.
+     *
+     * @param availableHeightDp height offered by the parent, or null when the parent is unbounded
+     * (for example inside a modal bottom sheet).
+     */
+    fun maxKeyboardHeight(
+        widthDp: Float,
+        availableHeightDp: Float?,
+        screenHeightDp: Float,
+        isPortrait: Boolean
+    ): Float {
+        val budget = availableHeightDp ?: screenHeightDp
+        val heightCap = if (isWide(widthDp)) {
+            widthDp * WIDE_HEIGHT_TO_WIDTH_RATIO
+        } else {
+            screenHeightDp * if (isPortrait) COMPACT_PORTRAIT_HEIGHT_RATIO else 1f
+        }
+
+        return minOf(budget, heightCap)
+    }
+}
