+            ),
+            rows[5].keys.map { it.byte }
+        )
+    }
+
+    @Test
+    fun reportsExplicitRowWeights() {
+        val rows = MacKeyboardLayoutFactory.build(englishUs).rows
+
+        assertEquals(
+            listOf(15f, 15f, 15f, 15f, 16f, 16.25f),
+            rows.map { it.totalWeight }
+        )
+    }
+
+    @Test
+    fun appliesStructuralWeightsToTheMovedKeys() {
+        val rows = MacKeyboardLayoutFactory.build(englishUs).rows
+
+        assertEquals(MacKeyboardKeyWeight.CAPS_LOCK, rows[3].keys.first().weight)
+        assertEquals(MacKeyboardKeyWeight.ENTER, rows[3].keys.last().weight)
+        assertEquals(MacKeyboardKeyWeight.SHIFT_LEFT, rows[4].keys.first().weight)
+        assertEquals(MacKeyboardKeyWeight.SHIFT_RIGHT, rows[4].keys.last().weight)
+        assertEquals(MacKeyboardKeyWeight.TAB, rows[2].keys.first().weight)
+        assertEquals(MacKeyboardKeyWeight.ROW_BACKSLASH, rows[2].keys.last().weight)
+        assertEquals(MacKeyboardKeyWeight.BACKSPACE, rows[1].keys.last().weight)
+        assertEquals(MacKeyboardKeyWeight.SPACE, rows[5].keys[3].weight)
+        assertTrue(rows[1].keys.drop(1).dropLast(1).all { it.weight == MacKeyboardKeyWeight.ORDINARY })
+        assertTrue(rows[2].keys.drop(1).dropLast(1).all { it.weight == MacKeyboardKeyWeight.ORDINARY })
+        assertTrue(rows[3].keys.drop(1).dropLast(1).all { it.weight == MacKeyboardKeyWeight.ORDINARY })
+        assertTrue(rows[4].keys.drop(2).dropLast(2).all { it.weight == MacKeyboardKeyWeight.ORDINARY })
+    }
+
+    @Test
+    fun keepsCapsLockAndModifiersOnTheirMacBookRows() {
+        allLayouts.forEach { layout ->
+            val macLayout = MacKeyboardLayoutFactory.build(layout)
+            val capsLock = macLayout.rows[3].keys.first()
+
+            assertEquals(MacKeyboardKeyKind.CAPS_LOCK, capsLock.kind)
+            assertEquals(AdvancedKeyBehavior.CAPS_LOCK, capsLock.behavior)
+            assertEquals(KeyboardKey.KEY_CAPS_LOCK.byte, capsLock.byte)
+
+            val leftShift = macLayout.rows[4].keys.first()
+            assertEquals(MacKeyboardKeyKind.MODIFIER, leftShift.kind)
+            assertEquals(KeyboardKey.KEY_SHIFT_LEFT.byte, leftShift.byte)
+
+            val rightShift = macLayout.rows[4].keys.last()
+            assertEquals(MacKeyboardKeyKind.MODIFIER, rightShift.kind)
+            assertEquals(KeyboardKey.KEY_SHIFT_RIGHT.byte, rightShift.byte)
+
+            assertEquals(
+                listOf(
+                    KeyboardKey.KEY_CTRL_LEFT.byte,
+                    KeyboardKey.KEY_ALT.byte,
+                    KeyboardKey.KEY_META_LEFT.byte,
+                    KeyboardKey.KEY_META_RIGHT.byte,
+                    KeyboardKey.KEY_ALT_GR.byte,
+                    KeyboardKey.KEY_CTRL_RIGHT.byte
+                ),
+                macLayout.rows[5].keys
+                    .filter { it.kind == MacKeyboardKeyKind.MODIFIER }
+                    .map { it.byte }
+            )
+        }
+    }
+
+    @Test
+    fun movesGraveAndAnsiBackslashOutOfTheLegacyRows() {
+        allLayouts.forEach { layout ->
+            val macLayout = MacKeyboardLayoutFactory.build(layout)
+
+            assertEquals(KeyboardKey.ROW_1_KEY_00.byte, macLayout.rows[1].keys.first().byte)
+            assertEquals(
+                KeyboardKey.ROW_3_KEY_11.byte,
+                macLayout.rows[2].keys.last().byte
+            )
+            assertTrue(macLayout.rows[3].keys.none { it.byte == KeyboardKey.ROW_3_KEY_11.byte })
+            assertTrue(macLayout.rows.drop(1).all { row -> row.keys.none { it.byte == KeyboardKey.ROW_1_KEY_00.byte && row !== macLayout.rows[1] } })
+        }
+    }
+
+    @Test
+    fun insertsTheIsoExtraKeyAfterLeftShift() {
+        val macLayout = MacKeyboardLayoutFactory.build(german)
+        val isoKey = macLayout.rows[4].keys[1]
+
+        assertEquals(KeyboardKey.ROW_4_KEY_00.byte, isoKey.byte)
+        assertEquals(MacKeyboardKeyKind.ISO_EXTRA, isoKey.kind)
+        assertEquals(MacKeyboardKeyWeight.ORDINARY, isoKey.weight)
+    }
+
+    @Test
+    fun frenchAndGermanRetainTheIsoExtraKey() {
+        listOf(french, german).forEach { layout ->
+            assertEquals(
+                layout.javaClass.simpleName,
+                listOf(KeyboardKey.ROW_4_KEY_00.byte),
+                MacKeyboardLayoutFactory.build(layout)
+                    .keys
+                    .filter { it.kind == MacKeyboardKeyKind.ISO_EXTRA }
+                    .map { it.byte }
+            )
+        }
+    }
+
+    @Test
+    fun englishUsKeepsItsOwnIsoUsageWithoutGainingASecondOne() {
+        val sourceIsoCount = sourceUsages(englishUs).count { it == KeyboardKey.ROW_4_KEY_00.byte }
+        val macLayout = MacKeyboardLayoutFactory.build(englishUs)
+
+        // The locale data already maps ROW_4_KEY_00 for US, so the strict ANSI rule must not
+        // synthesise another ISO key and must not drop the existing usage either.
+        assertEquals(1, sourceIsoCount)
+        assertEquals(sourceIsoCount, macLayout.keys.count { it.byte == KeyboardKey.ROW_4_KEY_00.byte })
+        assertEquals(1, macLayout.keys.count { it.kind == MacKeyboardKeyKind.ISO_EXTRA })
+    }
+
+    @Test
+    fun keepsEveryLanguageCharacterLegend() {
+        allLayouts.forEach { layout ->
+            val macLayout = MacKeyboardLayoutFactory.build(layout)
+            val sourceKeys = (layout.line1 + layout.line2 + layout.line3 + layout.line4).toList()
+
+            sourceKeys.forEach { sourceKey ->
+                val builtKey = macLayout.keys.first { it.byte == sourceKey.byte }
+                assertEquals(
+                    "${layout.javaClass.simpleName} legend of ${sourceKey.byte.toInt() and 0xFF}",
+                    sourceKey,
+                    builtKey.key.withWeight(sourceKey.weight)
+                )
+            }
+        }
+    }
+}
