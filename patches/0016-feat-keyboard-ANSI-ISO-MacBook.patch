+                KeyboardKey.ROW_3_KEY_08.byte,
+                KeyboardKey.ROW_3_KEY_09.byte,
+                KeyboardKey.ROW_3_KEY_10.byte,
+                KeyboardKey.KEY_ENTER.byte
+            ),
+            rows[3].keys.map { it.byte }
+        )
+        assertEquals(
+            listOf(
+                KeyboardKey.KEY_SHIFT_LEFT.byte,
+                KeyboardKey.ROW_4_KEY_00.byte,
+                KeyboardKey.ROW_4_KEY_01.byte,
+                KeyboardKey.ROW_4_KEY_02.byte,
+                KeyboardKey.ROW_4_KEY_03.byte,
+                KeyboardKey.ROW_4_KEY_04.byte,
+                KeyboardKey.ROW_4_KEY_05.byte,
+                KeyboardKey.ROW_4_KEY_06.byte,
+                KeyboardKey.ROW_4_KEY_07.byte,
+                KeyboardKey.ROW_4_KEY_08.byte,
+                KeyboardKey.ROW_4_KEY_09.byte,
+                KeyboardKey.ROW_4_KEY_10.byte,
+                KeyboardKey.KEY_UP_ARROW.byte,
+                KeyboardKey.KEY_SHIFT_RIGHT.byte
+            ),
+            rows[4].keys.map { it.byte }
+        )
+        assertEquals(
+            listOf(
+                KeyboardKey.KEY_CTRL_LEFT.byte,
+                KeyboardKey.KEY_ALT.byte,
+                KeyboardKey.KEY_META_LEFT.byte,
+                KeyboardKey.KEY_SPACE_BAR.byte,
