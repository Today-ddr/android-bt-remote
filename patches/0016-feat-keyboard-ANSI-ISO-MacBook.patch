+class MacKeyboardLayoutFactoryTest {
+
+    // The factory only reads the language arrays, it never needs Android resources.
+    private val context = ContextWrapper(null)
+
+    private val englishUs = EnglishUSAdvancedKeyboardLayout(context)
+    private val englishUk = EnglishUKAdvancedKeyboardLayout(context)
+    private val spanish = SpanishAdvancedKeyboardLayout(context)
+    private val french = FrenchAdvancedKeyboardLayout(context)
+    private val german = GermanAdvancedKeyboardLayout(context)
+    private val russian = RussianAdvancedKeyboardLayout(context)
+    private val czech = CzechAdvancedKeyboardLayout(context)
+    private val polish = PolishAdvancedKeyboardLayout(context)
+    private val portuguese = PortugueseAdvancedKeyboardLayout(context)
+    private val portugueseBr = PortugueseBRAdvancedKeyboardLayout(context)
+    private val greek = GreekAdvancedKeyboardLayout(context)
+    private val turkish = TurkishAdvancedKeyboardLayout(context)
+    private val hebrew = HebrewAdvancedKeyboardLayout(context)
+    private val bulgarian = BulgarianAdvancedKeyboardLayout(context)
+    private val ukrainian = UkrainianAdvancedKeyboardLayout(context)
+    private val persian = PersianAdvancedKeyboardLayout(context)
+    private val arabic = ArabicAdvancedKeyboardLayout(context)
+
+    private val allLayouts: List<AdvancedKeyboardLayout> = listOf(
+        englishUs,
+        englishUk,
+        spanish,
+        french,
+        german,
+        russian,
+        czech,
+        polish,
+        portuguese,
+        portugueseBr,
+        greek,
+        turkish,
+        hebrew,
+        bulgarian,
+        ukrainian,
+        persian,
+        arabic
+    )
+
+    private val structuralKeys: List<MacKeyboardKey> =
+        MacKeyboardSpec.functionRow.keys +
+                listOf(
+                    MacKeyboardSpec.tab,
+                    MacKeyboardSpec.backspace,
+                    MacKeyboardSpec.capsLock,
+                    MacKeyboardSpec.enter,
+                    MacKeyboardSpec.shiftLeft,
+                    MacKeyboardSpec.shiftRight,
+                    MacKeyboardSpec.upArrow
+                ) +
+                MacKeyboardSpec.bottomRow.keys
+
+    // A modifier is a bit in the first report byte while a usage is an array entry, so a key such
+    // as F7 (0x40) legitimately shares its byte with the right Alt modifier bit.
+    private val usageOrder = compareBy<Pair<Byte, AdvancedKeyBehavior>>(
+        { it.first },
+        { it.second.ordinal }
+    )
+
+    private fun sourceUsages(layout: AdvancedKeyboardLayout): List<Byte> =
+        layout.line1.map { it.byte } +
+                layout.line2.map { it.byte } +
+                layout.line3.map { it.byte } +
+                layout.line4.map { it.byte }
+
+    @Test
+    fun buildsSixNonEmptyRowsForEveryLanguage() {
+        assertEquals(17, allLayouts.size)
+
+        allLayouts.forEach { layout ->
+            val macLayout = MacKeyboardLayoutFactory.build(layout)
+
+            assertEquals(layout.javaClass.simpleName, 6, macLayout.rows.size)
+            assertTrue(layout.javaClass.simpleName, macLayout.rows.all { it.keys.isNotEmpty() })
+        }
+    }
+
+    @Test
+    fun preservesEverySourceKeyOnceWithItsBehaviorForEveryLanguage() {
+        allLayouts.forEach { layout ->
+            val macLayout = MacKeyboardLayoutFactory.build(layout)
+            val sourceKeys = (layout.line1 + layout.line2 + layout.line3 + layout.line4).toList()
+
+            sourceKeys.forEach { sourceKey ->
+                assertEquals(
+                    "${layout.javaClass.simpleName} key ${sourceKey.byte.toInt() and 0xFF}/${sourceKey.behavior}",
+                    1,
+                    macLayout.keys.count {
+                        it.byte == sourceKey.byte && it.behavior == sourceKey.behavior
+                    }
+                )
+            }
+        }
+    }
+
+    @Test
+    fun placesSourceAndStructuralKeysExactlyOnceForEveryLanguage() {
+        allLayouts.forEach { layout ->
+            val macLayout = MacKeyboardLayoutFactory.build(layout)
+            val expected = (
+                    (layout.line1 + layout.line2 + layout.line3 + layout.line4)
+                        .map { it.byte to it.behavior } +
+                            structuralKeys.map { it.byte to it.behavior }
+                    ).sortedWith(usageOrder)
+            val actual = macLayout.keys.map { it.byte to it.behavior }.sortedWith(usageOrder)
+
+            assertEquals(layout.javaClass.simpleName, expected, actual)
+        }
+    }
+
+    @Test
+    fun keepsRowsInMacBookOrderForEnglishUs() {
+        val rows = MacKeyboardLayoutFactory.build(englishUs).rows
+
+        assertEquals(
+            listOf(
+                KeyboardKey.KEY_ESCAPE.byte,
+                KeyboardKey.KEY_F1.byte,
+                KeyboardKey.KEY_F2.byte,
+                KeyboardKey.KEY_F3.byte,
+                KeyboardKey.KEY_F4.byte,
+                KeyboardKey.KEY_F5.byte,
+                KeyboardKey.KEY_F6.byte,
+                KeyboardKey.KEY_F7.byte,
+                KeyboardKey.KEY_F8.byte,
+                KeyboardKey.KEY_F9.byte,
+                KeyboardKey.KEY_F10.byte,
+                KeyboardKey.KEY_F11.byte,
+                KeyboardKey.KEY_F12.byte,
+                KeyboardKey.KEY_PRINT_SCREEN.byte,
+                KeyboardKey.KEY_DELETE_FORWARD.byte
+            ),
+            rows[0].keys.map { it.byte }
+        )
+        assertEquals(
+            listOf(
+                KeyboardKey.ROW_1_KEY_00.byte,
+                KeyboardKey.ROW_1_KEY_01.byte,
+                KeyboardKey.ROW_1_KEY_02.byte,
+                KeyboardKey.ROW_1_KEY_03.byte,
+                KeyboardKey.ROW_1_KEY_04.byte,
+                KeyboardKey.ROW_1_KEY_05.byte,
+                KeyboardKey.ROW_1_KEY_06.byte,
+                KeyboardKey.ROW_1_KEY_07.byte,
+                KeyboardKey.ROW_1_KEY_08.byte,
+                KeyboardKey.ROW_1_KEY_09.byte,
+                KeyboardKey.ROW_1_KEY_10.byte,
+                KeyboardKey.ROW_1_KEY_11.byte,
+                KeyboardKey.ROW_1_KEY_12.byte,
+                KeyboardKey.KEY_DELETE.byte
+            ),
+            rows[1].keys.map { it.byte }
+        )
+        assertEquals(
+            listOf(
+                KeyboardKey.KEY_TAB.byte,
+                KeyboardKey.ROW_2_KEY_00.byte,
+                KeyboardKey.ROW_2_KEY_01.byte,
+                KeyboardKey.ROW_2_KEY_02.byte,
+                KeyboardKey.ROW_2_KEY_03.byte,
+                KeyboardKey.ROW_2_KEY_04.byte,
+                KeyboardKey.ROW_2_KEY_05.byte,
+                KeyboardKey.ROW_2_KEY_06.byte,
+                KeyboardKey.ROW_2_KEY_07.byte,
+                KeyboardKey.ROW_2_KEY_08.byte,
+                KeyboardKey.ROW_2_KEY_09.byte,
+                KeyboardKey.ROW_2_KEY_10.byte,
+                KeyboardKey.ROW_2_KEY_11.byte,
+                KeyboardKey.ROW_3_KEY_11.byte
+            ),
+            rows[2].keys.map { it.byte }
+        )
+        assertEquals(
+            listOf(
+                KeyboardKey.KEY_CAPS_LOCK.byte,
+                KeyboardKey.ROW_3_KEY_00.byte,
+                KeyboardKey.ROW_3_KEY_01.byte,
+                KeyboardKey.ROW_3_KEY_02.byte,
+                KeyboardKey.ROW_3_KEY_03.byte,
+                KeyboardKey.ROW_3_KEY_04.byte,
