+package com.atharok.btremote.domain.entities.remoteInput.keyboard.mac
+
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.KeyboardKey
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.advancedKeyboard.AdvancedKeyBehavior
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.advancedKeyboard.AdvancedKeyboardKey
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.advancedKeyboard.AdvancedKeyboardLayout
+
+/**
+ * Turns a language mapping into the physical MacBook presentation.
+ *
+ * Keys are relocated by HID usage, never by legend or array index, so a language keeps all of its
+ * usages and only changes its position on screen. Weights are assigned here instead of being read
+ * from the legacy language rows.
+ */
+object MacKeyboardLayoutFactory {
+
+    fun build(layout: AdvancedKeyboardLayout): MacKeyboardLayout {
+        val line1 = layout.line1.toList()
+        val line2 = layout.line2.toList()
+        val line3 = layout.line3.toList()
+        val line4 = layout.line4.toList()
+
+        // The legacy rows keep the ANSI backslash and the ISO extra key inside the home and shift
+        // rows, so they are pulled out before the remaining characters are placed.
+        val grave = line4.firstOrNull { it.byte == KeyboardKey.ROW_1_KEY_00.byte }
+        val isoExtra = line4.firstOrNull { it.byte == KeyboardKey.ROW_4_KEY_00.byte }
+        val ansiBackslash = line3.firstOrNull { it.byte == KeyboardKey.ROW_3_KEY_11.byte }
+        val shiftRowMovedUsages = setOfNotNull(grave?.byte, isoExtra?.byte)
+        val homeRowMovedUsages = setOfNotNull(ansiBackslash?.byte)
+
+        val numberRow = buildList {
+            grave?.let { add(it.toMacKey(MacKeyboardKeyWeight.ORDINARY)) }
+            addAll(line1.map { it.toMacKey(MacKeyboardKeyWeight.ORDINARY) })
+            add(MacKeyboardSpec.backspace)
+        }
+
+        val qwertyRow = buildList {
+            add(MacKeyboardSpec.tab)
+            addAll(line2.map { it.toMacKey(MacKeyboardKeyWeight.ORDINARY) })
+            ansiBackslash?.let { add(it.toMacKey(MacKeyboardKeyWeight.ROW_BACKSLASH)) }
+        }
+
+        val homeRow = buildList {
+            add(MacKeyboardSpec.capsLock)
+            addAll(
+                line3
+                    .filterNot { it.byte in homeRowMovedUsages }
+                    .map { it.toMacKey(MacKeyboardKeyWeight.ORDINARY) }
+            )
+            add(MacKeyboardSpec.enter)
+        }
+
+        val shiftRow = buildList {
+            add(MacKeyboardSpec.shiftLeft)
+            isoExtra?.let {
+                add(it.toMacKey(MacKeyboardKeyWeight.ORDINARY, MacKeyboardKeyKind.ISO_EXTRA))
+            }
+            addAll(
+                line4
+                    .filterNot { it.byte in shiftRowMovedUsages }
+                    .map { it.toMacKey(MacKeyboardKeyWeight.ORDINARY) }
+            )
+            add(MacKeyboardSpec.upArrow)
+            add(MacKeyboardSpec.shiftRight)
+        }
+
+        return MacKeyboardLayout(
+            rows = listOf(
+                MacKeyboardSpec.functionRow,
+                MacKeyboardRow(numberRow),
+                MacKeyboardRow(qwertyRow),
+                MacKeyboardRow(homeRow),
+                MacKeyboardRow(shiftRow),
+                MacKeyboardSpec.bottomRow
+            )
+        )
+    }
+
+    private fun AdvancedKeyboardKey.toMacKey(
+        weight: Float,
+        kind: MacKeyboardKeyKind = kindOf(this)
+    ): MacKeyboardKey = MacKeyboardKey(key = withWeight(weight), kind = kind)
+
+    private fun kindOf(key: AdvancedKeyboardKey): MacKeyboardKeyKind = when (key.behavior) {
+        AdvancedKeyBehavior.CAPS_LOCK -> MacKeyboardKeyKind.CAPS_LOCK
+        AdvancedKeyBehavior.MODIFIER -> MacKeyboardKeyKind.MODIFIER
+        AdvancedKeyBehavior.KEY -> MacKeyboardKeyKind.ORDINARY
+    }
+}
