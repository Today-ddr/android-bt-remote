@@ -0,0 +1,179 @@
+package com.atharok.btremote.ui.views.mouse
+
+import androidx.compose.foundation.gestures.awaitEachGesture
+import androidx.compose.foundation.gestures.awaitFirstDown
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberUpdatedState
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Shape
+import androidx.compose.ui.input.pointer.PointerEvent
+import androidx.compose.ui.input.pointer.pointerInput
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.unit.Density
+import androidx.compose.ui.unit.dp
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.LifecycleEventObserver
+import androidx.lifecycle.compose.LocalLifecycleOwner
+import com.atharok.btremote.domain.entities.remoteInput.MouseAction
+import com.atharok.btremote.domain.entities.remoteInput.trackpad.TrackpadGestureCommand
+import com.atharok.btremote.domain.entities.remoteInput.trackpad.TrackpadGestureCommandMapper
+import com.atharok.btremote.domain.entities.remoteInput.trackpad.TrackpadGestureOutput
+import com.atharok.btremote.domain.entities.remoteInput.trackpad.TrackpadGestureRecognizer
+import com.atharok.btremote.domain.entities.remoteInput.trackpad.TrackpadPointer
+import com.atharok.btremote.domain.entities.remoteInput.trackpad.TrackpadTouch
+import com.atharok.btremote.domain.entities.settings.TrackpadSettings
+import com.atharok.btremote.ui.components.DefaultElevatedCard
+import com.atharok.btremote.ui.haptics.LocalHapticActions
+
+private data class GestureThresholds(
+    val tapSlop: Float,
+    val scrollClaimDistance: Float,
+    val swipeDistance: Float,
+    val scrollStep: Float
+)
+
+@Composable
+fun MacTrackpad(
+    mouseSpeed: Float,
+    scrollSpeed: Float,
+    shouldInvertMouseScrollingDirection: Boolean,
+    trackpadSettings: TrackpadSettings,
+    sendMouseInput: (MouseAction, Float, Float, Float) -> Unit,
+    sendKeyboardReport: (ByteArray) -> Unit,
+    shape: Shape,
+    modifier: Modifier = Modifier
+) {
+    val density = LocalDensity.current
+    val thresholds = remember(density) { density.gestureThresholds() }
+    val recognizer = remember(
+        trackpadSettings,
+        shouldInvertMouseScrollingDirection,
+        thresholds
+    ) {
+        TrackpadGestureRecognizer(
+            settings = trackpadSettings,
+            invertScroll = shouldInvertMouseScrollingDirection,
+            scrollStep = thresholds.scrollStep,
+            tapSlop = thresholds.tapSlop,
+            scrollClaimDistance = thresholds.scrollClaimDistance,
+            swipeDistance = thresholds.swipeDistance
+        )
+    }
+    val commandMapper = remember(trackpadSettings, mouseSpeed, scrollSpeed) {
+        TrackpadGestureCommandMapper(
+            settings = trackpadSettings,
+            mouseSpeed = mouseSpeed,
+            scrollSpeed = scrollSpeed
+        )
+    }
+    val hapticActions = LocalHapticActions.current
+    val currentHapticActions by rememberUpdatedState(hapticActions)
+    val currentSendMouseInput by rememberUpdatedState(sendMouseInput)
+    val currentSendKeyboardReport by rememberUpdatedState(sendKeyboardReport)
+    val lifecycleOwner = LocalLifecycleOwner.current
+
+    fun execute(outputs: List<TrackpadGestureOutput>) {
+        commandMapper.map(outputs).forEach { command ->
+            when (command) {
+                is TrackpadGestureCommand.Mouse -> currentSendMouseInput(
+                    command.button,
+                    command.dx,
+                    command.dy,
+                    command.wheel
+                )
+                is TrackpadGestureCommand.Keyboard -> {
+                    currentSendKeyboardReport(command.press)
+                    currentSendKeyboardReport(command.release)
+                }
+                is TrackpadGestureCommand.Haptic -> {
+                    currentHapticActions.performTrackpad(command.event)
+                }
+            }
+        }
+    }
+
+    fun resetAndRelease() {
+        execute(recognizer.reset())
+        currentSendMouseInput(MouseAction.NONE, 0f, 0f, 0f)
+    }
+
+    DisposableEffect(lifecycleOwner, recognizer) {
+        val observer = LifecycleEventObserver { _, event ->
+            if (event == Lifecycle.Event.ON_STOP) {
+                resetAndRelease()
+            }
+        }
+        lifecycleOwner.lifecycle.addObserver(observer)
+
+        onDispose {
+            lifecycleOwner.lifecycle.removeObserver(observer)
+            resetAndRelease()
+        }
+    }
+
+    DefaultElevatedCard(modifier = modifier, shape = shape) {
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .pointerInput(recognizer, commandMapper) {
+                    awaitEachGesture {
+                        var endedCleanly = false
+                        try {
+                            awaitFirstDown(requireUnconsumed = false)
+                            currentEvent.toTrackpadTouch().let { touch ->
+                                execute(recognizer.onTouch(touch))
+                            }
+                            currentEvent.consumePressedPointers()
+
+                            while (true) {
+                                val event = awaitPointerEvent()
+                                execute(recognizer.onTouch(event.toTrackpadTouch()))
+                                event.consumePressedPointers()
+                                if (event.changes.none { it.pressed }) {
+                                    endedCleanly = true
+                                    break
+                                }
+                            }
+                        } finally {
+                            if (!endedCleanly) {
+                                resetAndRelease()
+                            }
+                        }
+                    }
+                }
+        )
+    }
+}
+
+private fun Density.gestureThresholds(): GestureThresholds = GestureThresholds(
+    tapSlop = 12.dp.toPx(),
+    scrollClaimDistance = 10.dp.toPx(),
+    swipeDistance = 40.dp.toPx(),
+    scrollStep = 6.dp.toPx()
+)
+
+private fun PointerEvent.toTrackpadTouch(): TrackpadTouch = TrackpadTouch(
+    pointers = changes
+        .asSequence()
+        .filter { it.pressed }
+        .map { change ->
+            TrackpadPointer(
+                id = change.id.value,
+                x = change.position.x,
+                y = change.position.y
+            )
+        }
+        .toList(),
+    eventTimeMillis = changes.maxOfOrNull { it.uptimeMillis } ?: 0L
+)
+
+private fun PointerEvent.consumePressedPointers() {
+    changes.forEach { change ->
+        if (change.pressed) change.consume()
+    }
+}
