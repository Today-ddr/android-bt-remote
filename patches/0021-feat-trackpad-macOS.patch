+package com.atharok.btremote.domain.entities.remoteInput.trackpad
+
+import com.atharok.btremote.domain.entities.remoteInput.MouseAction
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.KeyboardKey
+import com.atharok.btremote.domain.entities.settings.TrackpadSettings
+
+sealed interface TrackpadGestureCommand {
+
+    data class Mouse(
+        val button: MouseAction,
+        val dx: Float,
+        val dy: Float,
+        val wheel: Float
+    ) : TrackpadGestureCommand
+
+    data class Keyboard(
+        val press: ByteArray,
+        val release: ByteArray
+    ) : TrackpadGestureCommand
+
+    data class Haptic(val event: TrackpadHapticEvent) : TrackpadGestureCommand
+}
+
+/**
+ * Converts semantic recognizer output into the existing HID mouse and keyboard report payloads.
+ * Keeping this mapping independent of Compose makes chord selection and direction resolution
+ * testable without an Android device.
+ */
+class TrackpadGestureCommandMapper(
+    private val settings: TrackpadSettings,
+    private val mouseSpeed: Float = 1f,
+    private val scrollSpeed: Float = 1f
+) {
+
+    fun map(outputs: List<TrackpadGestureOutput>): List<TrackpadGestureCommand> =
+        outputs.flatMap(::map)
+
+    fun map(output: TrackpadGestureOutput): List<TrackpadGestureCommand> = when (output) {
+        is TrackpadGestureOutput.Move -> listOf(
+            TrackpadGestureCommand.Mouse(
+                button = if (output.dragging) MouseAction.MOUSE_CLICK_LEFT else MouseAction.NONE,
+                dx = output.dx * mouseSpeed,
+                dy = output.dy * mouseSpeed,
+                wheel = 0f
+            )
+        )
+
+        is TrackpadGestureOutput.Click -> listOf(
+            TrackpadGestureCommand.Mouse(output.button, 0f, 0f, 0f),
+            TrackpadGestureCommand.Mouse(MouseAction.NONE, 0f, 0f, 0f)
+        )
+
+        TrackpadGestureOutput.DragStart -> listOf(
+            TrackpadGestureCommand.Mouse(MouseAction.MOUSE_CLICK_LEFT, 0f, 0f, 0f)
+        )
+
+        TrackpadGestureOutput.DragEnd -> listOf(
+            TrackpadGestureCommand.Mouse(MouseAction.NONE, 0f, 0f, 0f)
+        )
+
+        is TrackpadGestureOutput.Scroll -> listOf(
+            TrackpadGestureCommand.Mouse(
+                button = MouseAction.NONE,
+                dx = 0f,
+                dy = 0f,
+                wheel = output.amount * scrollSpeed
+            )
+        )
+
+        is TrackpadGestureOutput.Zoom -> executePinch(output.scaleDelta)
+        is TrackpadGestureOutput.Rotate -> execute(resolveRotationAction(output.radians))
+        is TrackpadGestureOutput.Action -> execute(output.action.chord)
+        is TrackpadGestureOutput.Haptic -> listOf(TrackpadGestureCommand.Haptic(output.event))
+    }
+
+    private fun executePinch(scaleDelta: Float): List<TrackpadGestureCommand> {
+        if (settings.pinchAction != TrackpadGestureAction.ZOOM) {
+            return execute(settings.pinchAction)
+        }
+        val key = if (scaleDelta > 0f) {
+            KeyboardKey.ROW_1_KEY_12.byte
+        } else {
+            KeyboardKey.ROW_1_KEY_11.byte
+        }
+        return execute(
+            GestureChord(
+                key = key,
+                modifiers = COMMAND_MODIFIER,
+                mouseButton = null
+            )
+        )
+    }
+
+    private fun resolveRotationAction(radians: Float): TrackpadGestureAction =
+        when (settings.rotationAction) {
+            TrackpadGestureAction.ROTATE_LEFT,
+            TrackpadGestureAction.ROTATE_RIGHT -> if (radians > 0f) {
+                TrackpadGestureAction.ROTATE_RIGHT
+            } else {
+                TrackpadGestureAction.ROTATE_LEFT
+            }
+            else -> settings.rotationAction
+        }
+
+    private fun execute(action: TrackpadGestureAction): List<TrackpadGestureCommand> =
+        execute(action.chord)
+
+    private fun execute(chord: GestureChord?): List<TrackpadGestureCommand> {
+        if (chord == null) return emptyList()
+        val mouseButton = chord.mouseButton
+        return if (mouseButton != null) {
+            listOf(
+                TrackpadGestureCommand.Mouse(mouseButton, 0f, 0f, 0f),
+                TrackpadGestureCommand.Mouse(MouseAction.NONE, 0f, 0f, 0f)
+            )
+        } else {
+            listOf(
+                TrackpadGestureCommand.Keyboard(
+                    press = chord.pressReport(),
+                    release = chord.releaseReport()
+                )
+            )
+        }
+    }
+
+    private companion object {
+        const val COMMAND_MODIFIER = 0x08
+    }
+}
