+package com.atharok.btremote.domain.entities.remoteInput.trackpad
+
+import com.atharok.btremote.domain.entities.remoteInput.MouseAction
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.KeyboardKey
+import com.atharok.btremote.domain.entities.settings.TrackpadSettings
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TrackpadGestureCommandMapperTest {
+
+    private val mapper = TrackpadGestureCommandMapper(
+        settings = TrackpadSettings(),
+        mouseSpeed = 2f,
+        scrollSpeed = 1.5f
+    )
+
+    @Test
+    fun mapsMoveClickDragAndScrollToExistingMouseReports() {
+        assertEquals(
+            listOf(TrackpadGestureCommand.Mouse(MouseAction.NONE, 4f, -6f, 0f)),
+            mapper.map(TrackpadGestureOutput.Move(2f, -3f, dragging = false))
+        )
+        assertEquals(
+            listOf(TrackpadGestureCommand.Mouse(MouseAction.MOUSE_CLICK_LEFT, 4f, -6f, 0f)),
+            mapper.map(TrackpadGestureOutput.Move(2f, -3f, dragging = true))
+        )
+        assertEquals(
+            listOf(
+                TrackpadGestureCommand.Mouse(MouseAction.MOUSE_CLICK_LEFT, 0f, 0f, 0f),
+                TrackpadGestureCommand.Mouse(MouseAction.NONE, 0f, 0f, 0f)
+            ),
+            mapper.map(TrackpadGestureOutput.Click(MouseAction.MOUSE_CLICK_LEFT))
+        )
+        assertEquals(
+            listOf(TrackpadGestureCommand.Mouse(MouseAction.MOUSE_CLICK_LEFT, 0f, 0f, 0f)),
+            mapper.map(TrackpadGestureOutput.DragStart)
+        )
+        assertEquals(
+            listOf(TrackpadGestureCommand.Mouse(MouseAction.NONE, 0f, 0f, 0f)),
+            mapper.map(TrackpadGestureOutput.DragEnd)
+        )
+        assertEquals(
+            listOf(TrackpadGestureCommand.Mouse(MouseAction.NONE, 0f, 0f, 3f)),
+            mapper.map(TrackpadGestureOutput.Scroll(2))
+        )
+    }
+
+    @Test
+    fun mapsHapticOutputWithoutTurningMovementIntoHaptics() {
+        assertEquals(
+            listOf(
+                TrackpadGestureCommand.Haptic(TrackpadHapticEvent.SCROLL)
+            ),
+            mapper.map(TrackpadGestureOutput.Haptic(TrackpadHapticEvent.SCROLL))
+        )
+        assertTrue(
+            mapper.map(TrackpadGestureOutput.Move(10f, 10f, dragging = false))
+                .none { it is TrackpadGestureCommand.Haptic }
+        )
+    }
+
+    @Test
+    fun executesEveryConfiguredChordAsPressAndReleaseReports() {
+        TrackpadGestureAction.entries.forEach { action ->
+            val commands = mapper.map(TrackpadGestureOutput.Action(action))
+            val chord = action.chord
+
+            when {
+                chord == null -> assertTrue("$action", commands.isEmpty())
+                chord.mouseButton != null -> {
+                    assertEquals("$action", 2, commands.size)
+                    assertEquals(
+                        "$action press",
+                        TrackpadGestureCommand.Mouse(chord.mouseButton, 0f, 0f, 0f),
+                        commands[0]
+                    )
+                    assertEquals(
+                        "$action release",
+                        TrackpadGestureCommand.Mouse(MouseAction.NONE, 0f, 0f, 0f),
+                        commands[1]
+                    )
+                }
+                else -> {
+                    assertEquals("$action", 1, commands.size)
+                    val keyboard = commands.single() as TrackpadGestureCommand.Keyboard
+                    assertArrayEquals("$action press", chord.pressReport(), keyboard.press)
+                    assertArrayEquals("$action release", chord.releaseReport(), keyboard.release)
+                    assertEquals("$action report size", 8, keyboard.press.size)
+                }
+            }
+        }
+    }
+
+    @Test
+    fun middleClickUsesTheMouseReportWhileSpotlightUsesAKeyboardReport() {
+        assertEquals(
+            listOf(
+                TrackpadGestureCommand.Mouse(MouseAction.MOUSE_CLICK_MIDDLE, 0f, 0f, 0f),
+                TrackpadGestureCommand.Mouse(MouseAction.NONE, 0f, 0f, 0f)
+            ),
+            mapper.map(TrackpadGestureOutput.Action(TrackpadGestureAction.MIDDLE_CLICK))
+        )
+
+        val spotlight = mapper
+            .map(TrackpadGestureOutput.Action(TrackpadGestureAction.SPOTLIGHT))
+            .single() as TrackpadGestureCommand.Keyboard
+        assertArrayEquals(
+            byteArrayOf(0x08, 0, KeyboardKey.KEY_SPACE_BAR.byte, 0, 0, 0, 0, 0),
+            spotlight.press
+        )
+        assertArrayEquals(ByteArray(8), spotlight.release)
+    }
+
+    @Test
+    fun zoomPinchUsesCommandEqualsOrMinusByDirection() {
+        val zoomIn = mapper
+            .map(TrackpadGestureOutput.Zoom(0.2f))
+            .single() as TrackpadGestureCommand.Keyboard
+        val zoomOut = mapper
+            .map(TrackpadGestureOutput.Zoom(-0.2f))
+            .single() as TrackpadGestureCommand.Keyboard
+
+        assertArrayEquals(
+            byteArrayOf(0x08, 0, KeyboardKey.ROW_1_KEY_12.byte, 0, 0, 0, 0, 0),
+            zoomIn.press
+        )
+        assertArrayEquals(
+            byteArrayOf(0x08, 0, KeyboardKey.ROW_1_KEY_11.byte, 0, 0, 0, 0, 0),
+            zoomOut.press
+        )
+    }
+
+    @Test
+    fun configuredPinchAndRotationActionsUseTheirSelectedChords() {
+        val spotlightPinch = TrackpadGestureCommandMapper(
+            settings = TrackpadSettings(pinchAction = TrackpadGestureAction.SPOTLIGHT)
+        )
+        val pinchIn = spotlightPinch
+            .map(TrackpadGestureOutput.Zoom(0.2f))
+            .single() as TrackpadGestureCommand.Keyboard
+        val pinchOut = spotlightPinch
+            .map(TrackpadGestureOutput.Zoom(-0.2f))
+            .single() as TrackpadGestureCommand.Keyboard
+        assertArrayEquals(pinchIn.press, pinchOut.press)
+        assertArrayEquals(pinchIn.release, pinchOut.release)
+
+        val rotateByDirection = TrackpadGestureCommandMapper(
+            settings = TrackpadSettings(rotationAction = TrackpadGestureAction.ROTATE_RIGHT)
+        )
+        val rotateRight = rotateByDirection
+            .map(TrackpadGestureOutput.Rotate(0.3f))
+            .single() as TrackpadGestureCommand.Keyboard
+        val rotateLeft = rotateByDirection
+            .map(TrackpadGestureOutput.Rotate(-0.3f))
+            .single() as TrackpadGestureCommand.Keyboard
+        assertArrayEquals(TrackpadGestureAction.ROTATE_RIGHT.chord!!.pressReport(), rotateRight.press)
+        assertArrayEquals(TrackpadGestureAction.ROTATE_LEFT.chord!!.pressReport(), rotateLeft.press)
+
+        val selectedSpotlight = TrackpadGestureCommandMapper(
+            settings = TrackpadSettings(rotationAction = TrackpadGestureAction.SPOTLIGHT)
+        )
+        assertArrayEquals(
+            TrackpadGestureAction.SPOTLIGHT.chord!!.pressReport(),
+            (selectedSpotlight.map(TrackpadGestureOutput.Rotate(-0.3f))
+                .single() as TrackpadGestureCommand.Keyboard).press
+        )
+    }
+
+    @Test
+    fun noneActionAndNoneRotationProduceNoHidCommands() {
+        assertTrue(mapper.map(TrackpadGestureOutput.Action(TrackpadGestureAction.NONE)).isEmpty())
+        assertTrue(mapper.map(TrackpadGestureOutput.Rotate(0.3f)).isEmpty())
+    }
+}
