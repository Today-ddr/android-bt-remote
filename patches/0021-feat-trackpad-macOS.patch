+package com.atharok.btremote.ui.haptics
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.CompositionLocalProvider
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.staticCompositionLocalOf
+import androidx.compose.ui.hapticfeedback.HapticFeedback
+import androidx.compose.ui.hapticfeedback.HapticFeedbackType
+import androidx.compose.ui.platform.LocalHapticFeedback
+import com.atharok.btremote.domain.entities.remoteInput.trackpad.TrackpadHapticEvent
+import com.atharok.btremote.domain.entities.settings.HapticSettings
+import com.atharok.btremote.domain.haptics.HapticSource
+import com.atharok.btremote.presentation.haptics.AndroidHapticFeedbackController
+
+internal data class HapticActions(
+    val trackpadTap: () -> Unit,
+    val scrollTick: () -> Unit,
+    val keyboardTap: () -> Unit
+) {
+
+    fun performTrackpad(event: TrackpadHapticEvent) {
+        if (event == TrackpadHapticEvent.SCROLL) {
+            scrollTick()
+        } else {
+            trackpadTap()
+        }
+    }
+}
+
+internal val LocalHapticActions = staticCompositionLocalOf {
+    HapticActions(
+        trackpadTap = {},
+        scrollTick = {},
+        keyboardTap = {}
+    )
+}
+
+@Composable
+internal fun HapticFeedbackProvider(
+    controller: AndroidHapticFeedbackController,
+    settings: HapticSettings,
+    content: @Composable () -> Unit
+) {
+    val actions = remember(controller, settings) {
+        HapticActions(
+            trackpadTap = { controller.tap(settings, HapticSource.TRACKPAD) },
+            scrollTick = { controller.scrollTick(settings) },
+            keyboardTap = { controller.tap(settings, HapticSource.KEYBOARD) }
+        )
+    }
+    val composeHapticFeedback = remember(actions) {
+        object : HapticFeedback {
+            override fun performHapticFeedback(hapticFeedbackType: HapticFeedbackType) {
+                actions.keyboardTap()
+            }
+        }
+    }
+
+    CompositionLocalProvider(
+        LocalHapticActions provides actions,
+        LocalHapticFeedback provides composeHapticFeedback,
+        content = content
+    )
+}
