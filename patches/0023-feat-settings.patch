+
+@Composable
+private fun GestureActionSetting(
+    @StringRes title: Int,
+    value: TrackpadGestureAction,
+    onValueChange: (TrackpadGestureAction) -> Unit,
+    modifier: Modifier = Modifier
+) {
+    val context = LocalContext.current
+    SettingsListDialog(
+        title = title,
+        dialogMessage = stringResource(id = R.string.gesture_mapping_info),
+        value = value,
+        onValueChange = onValueChange,
+        items = TrackpadGestureAction.entries,
+        convertValueToString = { gestureActionLabel(context, it) },
+        modifier = modifier
+    )
+}
+
+@Composable
+private fun HapticIntensitySetting(
+    intensity: HapticIntensity,
+    onIntensityChange: (HapticIntensity) -> Unit,
+    modifier: Modifier = Modifier
+) {
+    Column(
+        modifier = modifier,
+        verticalArrangement = Arrangement.spacedBy(dimensionResource(id = R.dimen.padding_small))
+    ) {
+        TextNormal(text = stringResource(id = R.string.haptics_intensity))
+        MultiChoiceSegmentedButtonRow(modifier = Modifier.fillMaxWidth()) {
+            HapticIntensity.entries.forEachIndexed { index, item ->
+                SegmentedButton(
+                    checked = item == intensity,
+                    onCheckedChange = { onIntensityChange(item) },
+                    shape = hapticSegmentShape(index),
+                ) {
+                    TextNormal(text = stringResource(id = item.titleRes()))
+                }
+            }
+        }
+        TextNormalSecondary(text = stringResource(id = R.string.haptics_intensity_info))
+    }
+}
+
+private fun hapticSegmentShape(index: Int): RoundedCornerShape = when (index) {
+    0 -> RoundedCornerShape(
+        topStartPercent = 50,
+        topEndPercent = 0,
+        bottomEndPercent = 0,
+        bottomStartPercent = 50
+    )
+    HapticIntensity.entries.lastIndex -> RoundedCornerShape(
+        topStartPercent = 0,
+        topEndPercent = 50,
+        bottomEndPercent = 50,
+        bottomStartPercent = 0
+    )
+    else -> RoundedCornerShape(percent = 0)
+}
+
+private fun gestureActionLabel(context: Context, action: TrackpadGestureAction): String {
+    val title = context.getString(action.titleRes())
+    return if (action.shortcutHint.isBlank()) title else "$title  ${action.shortcutHint}"
+}
+
+@StringRes
+private fun TrackpadGestureAction.titleRes(): Int = when (this) {
+    TrackpadGestureAction.NONE -> R.string.gesture_action_none
+    TrackpadGestureAction.APP_SWITCHER -> R.string.gesture_action_app_switcher
+    TrackpadGestureAction.HOME -> R.string.gesture_action_home
+    TrackpadGestureAction.DOCK -> R.string.gesture_action_dock
+    TrackpadGestureAction.PREVIOUS_APP -> R.string.gesture_action_previous_app
+    TrackpadGestureAction.NEXT_APP -> R.string.gesture_action_next_app
+    TrackpadGestureAction.SPOTLIGHT -> R.string.gesture_action_spotlight
+    TrackpadGestureAction.CONTROL_CENTER -> R.string.gesture_action_control_center
+    TrackpadGestureAction.NOTIFICATION_CENTER -> R.string.gesture_action_notification_center
+    TrackpadGestureAction.MISSION_CONTROL -> R.string.gesture_action_mission_control
+    TrackpadGestureAction.APP_EXPOSE -> R.string.gesture_action_app_expose
+    TrackpadGestureAction.SWITCH_SPACE_LEFT -> R.string.gesture_action_switch_space_left
+    TrackpadGestureAction.SWITCH_SPACE_RIGHT -> R.string.gesture_action_switch_space_right
+    TrackpadGestureAction.SCREENSHOT -> R.string.gesture_action_screenshot
+    TrackpadGestureAction.MIDDLE_CLICK -> R.string.gesture_action_middle_click
+    TrackpadGestureAction.ZOOM -> R.string.gesture_action_zoom
+    TrackpadGestureAction.ROTATE_LEFT -> R.string.gesture_action_rotate_left
+    TrackpadGestureAction.ROTATE_RIGHT -> R.string.gesture_action_rotate_right
+}
+
+@StringRes
+private fun HapticIntensity.titleRes(): Int = when (this) {
+    HapticIntensity.LIGHT -> R.string.haptics_intensity_light
+    HapticIntensity.MEDIUM -> R.string.haptics_intensity_medium
+    HapticIntensity.STRONG -> R.string.haptics_intensity_strong
+}
