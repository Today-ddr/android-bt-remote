+@Composable
+fun TrackpadGestureSettingsScreen(
+    navigateUp: () -> Unit,
+    modifier: Modifier = Modifier,
+    settingsViewModel: SettingsViewModel = koinViewModel()
+) {
+    val trackpadSettings by settingsViewModel.trackpadSettingsFlow
+        .collectAsStateWithLifecycle(TrackpadSettings())
+    val hapticSettings by settingsViewModel.hapticSettingsFlow
+        .collectAsStateWithLifecycle(HapticSettings())
+
+    AppScaffold(
+        title = stringResource(id = R.string.trackpad_gestures_and_haptics),
+        modifier = modifier,
+        navigateUp = {
+            NavigateUpIconButton(navigateUp)
+        }
+    ) { innerPadding ->
+        val horizontalPadding = dimensionResource(id = R.dimen.padding_max)
+        val verticalPadding = dimensionResource(id = R.dimen.padding_large)
+        val itemModifier = Modifier
+            .fillMaxWidth()
+            .padding(horizontal = horizontalPadding, vertical = verticalPadding)
+
+        Column(
+            modifier = Modifier
+                .verticalScroll(rememberScrollState())
+                .padding(innerPadding)
+        ) {
+            SettingsTitle(
+                text = stringResource(id = R.string.trackpad_gestures),
+                icon = AppIcons.Gesture,
+                iconDescription = stringResource(id = R.string.trackpad_gestures),
+                modifier = itemModifier
+            )
+
+            SettingsSwitch(
+                primaryText = stringResource(id = R.string.double_tap_drag),
+                secondaryText = stringResource(id = R.string.double_tap_drag_info),
+                checked = trackpadSettings.doubleTapDragEnabled,
+                onCheckedChange = { settingsViewModel.saveDoubleTapDragEnabled(it) },
+                modifier = itemModifier
+            )
+
+            GestureActionSetting(
+                title = R.string.pinch_gesture,
+                value = trackpadSettings.pinchAction,
+                onValueChange = { settingsViewModel.savePinchAction(it) },
+                modifier = itemModifier
+            )
+
+            GestureActionSetting(
+                title = R.string.rotation_gesture,
+                value = trackpadSettings.rotationAction,
+                onValueChange = { settingsViewModel.saveRotationAction(it) },
+                modifier = itemModifier
+            )
+
+            HorizontalDivider(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .padding(vertical = verticalPadding)
