--- a/app/src/main/java/com/atharok/btremote/domain/entities/remoteInput/trackpad/TrackpadGestureAction.kt
+++ b/app/src/main/java/com/atharok/btremote/domain/entities/remoteInput/trackpad/TrackpadGestureAction.kt
@@ -49,6 +49,14 @@ enum class TrackpadGestureAction(val persistedValue: String) {
             ROTATE_RIGHT -> keyChord(KeyboardKey.ROW_2_KEY_03, COMMAND)
         }
 
+    val shortcutHint: String
+        get() = when (this) {
+            NONE -> ""
+            MIDDLE_CLICK -> "Middle click"
+            ZOOM -> "⌘= / ⌘-"
+            else -> chord?.shortcutHint().orEmpty()
+        }
+
     private fun keyChord(key: KeyboardKey, modifiers: Int) = GestureChord(
         key = key.byte,
         modifiers = modifiers,
@@ -62,3 +70,39 @@ enum class TrackpadGestureAction(val persistedValue: String) {
         const val COMMAND = 0x08
     }
 }
+
+private fun GestureChord.shortcutHint(): String {
+    val button = mouseButton
+    if (button != null) {
+        return if (button == MouseAction.MOUSE_CLICK_MIDDLE) "Middle click" else ""
+    }
+    val keyLabel = when (key) {
+        KeyboardKey.KEY_UP_ARROW.byte -> "↑"
+        KeyboardKey.KEY_DOWN_ARROW.byte -> "↓"
+        KeyboardKey.KEY_LEFT_ARROW.byte -> "←"
+        KeyboardKey.KEY_RIGHT_ARROW.byte -> "→"
+        KeyboardKey.KEY_TAB.byte -> "Tab"
+        KeyboardKey.KEY_SPACE_BAR.byte -> "Space"
+        KeyboardKey.ROW_1_KEY_03.byte -> "3"
+        KeyboardKey.ROW_1_KEY_11.byte -> "-"
+        KeyboardKey.ROW_1_KEY_12.byte -> "="
+        KeyboardKey.ROW_2_KEY_03.byte -> "R"
+        KeyboardKey.ROW_3_KEY_00.byte -> "A"
+        KeyboardKey.ROW_3_KEY_05.byte -> "H"
+        KeyboardKey.ROW_4_KEY_03.byte -> "C"
+        KeyboardKey.ROW_4_KEY_06.byte -> "N"
+        else -> "?"
+    }
+    return buildString {
+        if (modifiers and MODIFIER_CONTROL != 0) append("⌃")
+        if (modifiers and MODIFIER_OPTION != 0) append("⌥")
+        if (modifiers and MODIFIER_SHIFT != 0) append("⇧")
+        if (modifiers and MODIFIER_COMMAND != 0) append("⌘")
+        append(keyLabel)
+    }
+}
+
+private const val MODIFIER_CONTROL = 0x01
+private const val MODIFIER_SHIFT = 0x02
+private const val MODIFIER_OPTION = 0x04
+private const val MODIFIER_COMMAND = 0x08
