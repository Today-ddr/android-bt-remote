@@ -0,0 +1,53 @@
+package com.atharok.btremote.domain.entities.remoteInput.keyboard.advancedKeyboard
+
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.KeyboardKey
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class AdvancedKeyboardKeyTest {
+
+    @Test
+    fun characterKeysAreOrdinaryKeys() {
+        val key = CharacterAdvancedKeyboardKey(
+            byte = KeyboardKey.ROW_3_KEY_00.byte,
+            weight = 1f,
+            text = "A"
+        )
+
+        assertEquals(AdvancedKeyBehavior.KEY, key.behavior)
+    }
+
+    @Test
+    fun textKeysDefaultToOrdinaryKeys() {
+        val key = TextAdvancedKeyboardKey(
+            byte = KeyboardKey.KEY_F1.byte,
+            weight = 1f,
+            text = "F1"
+        )
+
+        assertEquals(AdvancedKeyBehavior.KEY, key.behavior)
+    }
+
+    @Test
+    fun modifierKeysCanOptIntoModifierBehavior() {
+        val key = TextAdvancedKeyboardKey(
+            byte = KeyboardKey.KEY_SHIFT_LEFT.byte,
+            weight = 1f,
+            text = "Shift",
+            behavior = AdvancedKeyBehavior.MODIFIER
+        )
+
+        assertEquals(AdvancedKeyBehavior.MODIFIER, key.behavior)
+    }
+
+    @Test
+    fun capsLockHasItsOwnBehavior() {
+        val key = CapsLockAdvancedKeyboardKey(
+            weight = 1.5f,
+            text = "Caps"
+        )
+
+        assertEquals(AdvancedKeyBehavior.CAPS_LOCK, key.behavior)
+        assertEquals(KeyboardKey.KEY_CAPS_LOCK.byte, key.byte)
+    }
+}
