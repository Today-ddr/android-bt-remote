 /**
  * Central orientation policy for the whole navigation graph.
  *
- * The keyboard and the trackpad need the long edge, so the input destination is
- * landscape. Setup and Settings are portrait pages; keeping them portrait means
- * opening either one from the input page asks the system to turn the device back
- * instead of leaving a landscape page with no dock.
+ * The keyboard and the trackpad need the long edge, so the input destination
+ * asks for sensor landscape. Every other page, including the setup, discovery,
+ * pairing and settings pages, follows the system: rotating the device is always
+ * allowed, and the pages adapt to whichever orientation the user chose.
  *
- * Every destination that is not the input page is portrait, including the
- * permission, activation, discovery and pairing pages.
+ * Because those pages can be landscape, the dock is not tied to the route
+ * alone: [DockVisibilityPolicy] hides it whenever a main page is landscape, so
+ * the device and settings pages keep the same portrait-only dock as before
+ * without the window forcing the device to rotate back.
  */
 object AppOrientationPolicy {
 
@@ -23,6 +27,6 @@ object AppOrientationPolicy {
         if (route == AppNavDestination.InputDestination.route) {
             AppScreenOrientation.LANDSCAPE
         } else {
-            AppScreenOrientation.PORTRAIT
+            AppScreenOrientation.UNSPECIFIED
         }
 }
