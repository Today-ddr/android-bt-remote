+package com.atharok.btremote.domain.entities.remoteInput
+
+import com.atharok.btremote.common.utils.KEYBOARD_REPORT_ID
+import com.atharok.btremote.common.utils.MOUSE_REPORT_ID
+import java.util.concurrent.ExecutorService
+import java.util.concurrent.Executors
+import java.util.concurrent.RejectedExecutionException
+import kotlin.math.abs
+
+/** The largest delta one HID mouse report can carry (a signed byte). */
+private const val MAX_MOUSE_DELTA = 127
+
+/**
+ * Runs tasks one at a time, in the order they were submitted.
+ *
+ * Kept as an interface so [HidReportSender] stays a plain JVM class: tests can
+ * drive the queue by hand instead of waiting on a thread.
+ */
+interface HidReportExecutor {
+
+    fun execute(task: Runnable)
+
+    /**
+     * Stops accepting new tasks. Tasks already submitted still run, which is
+     * what keeps a release report queued before shutdown from being dropped.
+     */
+    fun shutdown()
+}
+
+/** The production executor: a single background thread, no parallelism. */
+class SingleThreadHidReportExecutor(
+    threadName: String = "hid-report-sender"
+) : HidReportExecutor {
+
+    private val executor: ExecutorService = Executors.newSingleThreadExecutor { task ->
+        Thread(task, threadName).apply { isDaemon = true }
+    }
+
+    override fun execute(task: Runnable) = executor.execute(task)
+
+    override fun shutdown() = executor.shutdown()
+}
+
+/**
+ * Serialises every report the UI produces onto one ordered queue.
+ *
+ * `BluetoothHidDevice.sendReport` is a synchronous Binder call, and the
+ * trackpad produces pointer events far faster than a BLE link can
+ * carry them. Sending from the UI thread therefore stalls frame production,
+ * which is what made the input page stutter; reports are now queued here and
+ * written by [executor] off the main thread instead.
+ *
+ * Ordering is the whole point, so the queue is strictly FIFO and only the
+ * worker thread ever calls [sendReport]: a key press must reach the host before
+ * its release, and a click's press before its release. The single exception is
+ * merging two adjacent pointer movements, which the host cannot observe as
+ * separate events anyway and which keeps high-frequency drags from filling the
+ * BLE queue. A movement is only ever merged with the report directly before it,
+ * so it can never overtake a key, click or scroll, which all break the run.
+ */
+class HidReportSender(
+    private val sendReport: (id: Int, bytes: ByteArray) -> Boolean,
+    private val executor: HidReportExecutor
+) {
+
+    private val lock = Any()
+    private val pending = ArrayDeque<PendingReport>()
+    private var isRunning = false
+
+    fun sendKeyboardReport(bytes: ByteArray) {
+        enqueue(PendingReport.Keyboard(bytes.copyOf()))
+    }
+
+    /**
+     * Queues one mouse report. The kind is inferred from what the report
+     * changes: a zero delta is a button transition (press, release, drag start
+     * or end), a non-zero wheel is a scroll, and anything else is movement.
+     * Only movement may be merged with the movement before it.
+     *
+     * Deltas are clamped here, exactly as a single report was before it was
+     * queued, so merging can only ever combine values that a report could
+     * already carry.
+     */
+    fun sendMouseReport(buttons: Byte, dx: Int, dy: Int, wheel: Int) {
+        val deltaX = dx.coerceIn(-MAX_MOUSE_DELTA, MAX_MOUSE_DELTA)
+        val deltaY = dy.coerceIn(-MAX_MOUSE_DELTA, MAX_MOUSE_DELTA)
+        val wheelDelta = wheel.coerceIn(-MAX_MOUSE_DELTA, MAX_MOUSE_DELTA)
+        val report = when {
+            wheelDelta != 0 -> PendingReport.Scroll(buttons, wheelDelta)
+            deltaX == 0 && deltaY == 0 -> PendingReport.Buttons(buttons)
+            else -> PendingReport.Move(buttons, deltaX, deltaY)
+        }
+        enqueue(report)
+    }
+
+    /**
+     * Stops the worker once the queue is empty. Reports already queued - in
+     * particular the release reports produced while the input page tears down -
+     * are still sent; nothing is discarded here.
+     */
+    fun close() {
+        executor.shutdown()
+    }
+
+    private fun enqueue(report: PendingReport) {
+        synchronized(lock) {
+            val tail = pending.lastOrNull()
+            if (tail is PendingReport.Move &&
+                report is PendingReport.Move &&
+                tail.buttons == report.buttons &&
+                canMerge(tail, report)
+            ) {
+                pending.removeLastOrNull()
+                pending.addLast(
+                    PendingReport.Move(
+                        buttons = tail.buttons,
+                        dx = tail.dx + report.dx,
+                        dy = tail.dy + report.dy
+                    )
+                )
+            } else {
+                pending.addLast(report)
+            }
+        }
+        scheduleDrain()
+    }
+
+    /**
+     * A merged delta has to stay inside one report's signed byte, otherwise the
+     * extra motion would be clamped away and the pointer would visibly stall.
+     */
+    private fun canMerge(first: PendingReport.Move, second: PendingReport.Move): Boolean =
+        abs(first.dx + second.dx) <= MAX_MOUSE_DELTA &&
+            abs(first.dy + second.dy) <= MAX_MOUSE_DELTA
+
+    private fun scheduleDrain() {
+        val start = synchronized(lock) {
+            if (isRunning) {
+                false
+            } else {
+                isRunning = true
+                true
+            }
+        }
+        if (!start) return
+
+        try {
+            executor.execute { drain() }
+        } catch (_: RejectedExecutionException) {
+            // close() shut the executor down before this task could be queued.
+            // Finish the queue here so a late release report is still sent
+            // instead of leaving a key or button held on the host.
+            drain()
+        }
+    }
+
+    private fun drain() {
+        while (true) {
+            val report = synchronized(lock) {
+                pending.removeFirstOrNull() ?: run {
+                    isRunning = false
+                    null
+                }
+            } ?: return
+
+            try {
+                sendReport(report.id, report.toBytes())
+            } catch (failure: Throwable) {
+                // Release the worker flag so the next enqueue can start a new
+                // drain, then surface the failure the way a synchronous send
+                // would have.
+                synchronized(lock) { isRunning = false }
+                throw failure
+            }
+        }
+    }
+}
+
+private sealed interface PendingReport {
+
+    val id: Int
+
+    fun toBytes(): ByteArray
+
+    class Keyboard(private val bytes: ByteArray) : PendingReport {
+        override val id: Int get() = KEYBOARD_REPORT_ID
+        override fun toBytes(): ByteArray = bytes
+    }
+
+    data class Move(
+        val buttons: Byte,
+        val dx: Int,
+        val dy: Int
+    ) : PendingReport {
+        override val id: Int get() = MOUSE_REPORT_ID
+        override fun toBytes(): ByteArray = mouseReportBytes(buttons, dx, dy, 0)
+    }
+
+    data class Buttons(val buttons: Byte) : PendingReport {
+        override val id: Int get() = MOUSE_REPORT_ID
+        override fun toBytes(): ByteArray = mouseReportBytes(buttons, 0, 0, 0)
+    }
+
+    data class Scroll(val buttons: Byte, val wheel: Int) : PendingReport {
+        override val id: Int get() = MOUSE_REPORT_ID
+        override fun toBytes(): ByteArray = mouseReportBytes(buttons, 0, 0, wheel)
+    }
+}
+
+private fun mouseReportBytes(buttons: Byte, dx: Int, dy: Int, wheel: Int): ByteArray =
+    byteArrayOf(buttons, dx.toByte(), dy.toByte(), wheel.toByte())
