@@ -0,0 +1,189 @@
+package com.atharok.btremote.domain.entities.remoteInput
+
+import com.atharok.btremote.common.utils.KEYBOARD_REPORT_ID
+import com.atharok.btremote.common.utils.MOUSE_REPORT_ID
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.concurrent.RejectedExecutionException
+
+class HidReportSenderTest {
+
+    private val executor = ManualExecutor()
+    private val sent = mutableListOf<SentReport>()
+    private val sender = HidReportSender(
+        sendReport = { id, bytes ->
+            sent += SentReport(id, bytes)
+            true
+        },
+        executor = executor
+    )
+
+    @Test
+    fun keyboardAndClickReportsKeepSubmissionOrder() {
+        val press = keyboardReport(0x04)
+        val release = keyboardReport(0x00)
+
+        sender.sendKeyboardReport(press)
+        sender.sendMouseReport(buttons = LEFT, dx = 0, dy = 0, wheel = 0)
+        sender.sendKeyboardReport(release)
+        sender.sendMouseReport(buttons = NONE, dx = 0, dy = 0, wheel = 0)
+
+        executor.runAll()
+
+        assertEquals(4, sent.size)
+        assertKeyboard(sent[0], press)
+        assertMouse(sent[1], buttons = LEFT, dx = 0, dy = 0, wheel = 0)
+        assertKeyboard(sent[2], release)
+        assertMouse(sent[3], buttons = NONE, dx = 0, dy = 0, wheel = 0)
+    }
+
+    @Test
+    fun adjacentMovesMergeIntoOneReport() {
+        sender.sendMouseReport(buttons = NONE, dx = 3, dy = 4, wheel = 0)
+        sender.sendMouseReport(buttons = NONE, dx = -1, dy = 2, wheel = 0)
+        sender.sendMouseReport(buttons = NONE, dx = 5, dy = 0, wheel = 0)
+
+        executor.runAll()
+
+        assertEquals(1, sent.size)
+        assertMouse(sent[0], buttons = NONE, dx = 7, dy = 6, wheel = 0)
+    }
+
+    @Test
+    fun movesAreNotMergedAcrossAClick() {
+        sender.sendMouseReport(buttons = NONE, dx = 10, dy = 0, wheel = 0)
+        sender.sendMouseReport(buttons = LEFT, dx = 0, dy = 0, wheel = 0)
+        sender.sendMouseReport(buttons = LEFT, dx = 4, dy = 0, wheel = 0)
+        sender.sendMouseReport(buttons = NONE, dx = 0, dy = 0, wheel = 0)
+        sender.sendMouseReport(buttons = NONE, dx = 7, dy = 0, wheel = 0)
+
+        executor.runAll()
+
+        assertEquals(5, sent.size)
+        assertMouse(sent[0], buttons = NONE, dx = 10, dy = 0, wheel = 0)
+        assertMouse(sent[1], buttons = LEFT, dx = 0, dy = 0, wheel = 0)
+        assertMouse(sent[2], buttons = LEFT, dx = 4, dy = 0, wheel = 0)
+        assertMouse(sent[3], buttons = NONE, dx = 0, dy = 0, wheel = 0)
+        assertMouse(sent[4], buttons = NONE, dx = 7, dy = 0, wheel = 0)
+    }
+
+    @Test
+    fun scrollAndKeyboardBreakMovementMerging() {
+        sender.sendMouseReport(buttons = NONE, dx = 2, dy = 0, wheel = 0)
+        sender.sendMouseReport(buttons = NONE, dx = 0, dy = 0, wheel = 3)
+        sender.sendMouseReport(buttons = NONE, dx = 5, dy = 0, wheel = 0)
+        sender.sendKeyboardReport(keyboardReport(0x04))
+        sender.sendMouseReport(buttons = NONE, dx = 6, dy = 0, wheel = 0)
+
+        executor.runAll()
+
+        assertEquals(5, sent.size)
+        assertMouse(sent[0], buttons = NONE, dx = 2, dy = 0, wheel = 0)
+        assertMouse(sent[1], buttons = NONE, dx = 0, dy = 0, wheel = 3)
+        assertMouse(sent[2], buttons = NONE, dx = 5, dy = 0, wheel = 0)
+        assertEquals(KEYBOARD_REPORT_ID, sent[3].id)
+        assertMouse(sent[4], buttons = NONE, dx = 6, dy = 0, wheel = 0)
+    }
+
+    @Test
+    fun movesThatWouldOverflowOneReportAreNotMerged() {
+        sender.sendMouseReport(buttons = NONE, dx = 100, dy = 0, wheel = 0)
+        sender.sendMouseReport(buttons = NONE, dx = 60, dy = 0, wheel = 0)
+
+        executor.runAll()
+
+        // Clamping the sum to 127 would silently drop motion, so the second
+        // movement stays a report of its own.
+        assertEquals(2, sent.size)
+        assertMouse(sent[0], buttons = NONE, dx = 100, dy = 0, wheel = 0)
+        assertMouse(sent[1], buttons = NONE, dx = 60, dy = 0, wheel = 0)
+    }
+
+    @Test
+    fun oversizedDeltaIsClampedToOneReport() {
+        sender.sendMouseReport(buttons = NONE, dx = 300, dy = -300, wheel = 0)
+
+        executor.runAll()
+
+        assertEquals(1, sent.size)
+        assertMouse(sent[0], buttons = NONE, dx = 127, dy = -127, wheel = 0)
+    }
+
+    @Test
+    fun closingTheSenderStillDrainsQueuedReports() {
+        sender.sendMouseReport(buttons = LEFT, dx = 0, dy = 0, wheel = 0)
+        sender.sendKeyboardReport(keyboardReport(0x00))
+
+        sender.close()
+        executor.runAll()
+
+        assertEquals(2, sent.size)
+        assertMouse(sent[0], buttons = LEFT, dx = 0, dy = 0, wheel = 0)
+        assertKeyboard(sent[1], keyboardReport(0x00))
+    }
+
+    @Test
+    fun releaseQueuedAfterCloseIsStillSent() {
+        sender.close()
+
+        sender.sendKeyboardReport(keyboardReport(0x00))
+
+        // The executor refuses new work once closed, so the sender had to
+        // finish the queue on the calling thread instead of dropping it.
+        assertEquals(1, sent.size)
+        assertKeyboard(sent[0], keyboardReport(0x00))
+        assertTrue(executor.hasNoQueuedWork())
+    }
+
+    private fun assertKeyboard(report: SentReport, expected: ByteArray) {
+        assertEquals(KEYBOARD_REPORT_ID, report.id)
+        assertArrayEquals(expected, report.bytes)
+    }
+
+    private fun assertMouse(report: SentReport, buttons: Byte, dx: Int, dy: Int, wheel: Int) {
+        assertEquals(MOUSE_REPORT_ID, report.id)
+        assertArrayEquals(
+            byteArrayOf(buttons, dx.toByte(), dy.toByte(), wheel.toByte()),
+            report.bytes
+        )
+    }
+
+    private fun keyboardReport(key: Int): ByteArray =
+        byteArrayOf(0, 0, key.toByte(), 0, 0, 0, 0, 0)
+
+    private data class SentReport(val id: Int, val bytes: ByteArray)
+
+    /**
+     * Runs work only when the test asks for it, so the queue can be inspected
+     * before the worker sees it.
+     */
+    private class ManualExecutor : HidReportExecutor {
+
+        private val tasks = ArrayDeque<Runnable>()
+        private var isShutdown = false
+
+        override fun execute(task: Runnable) {
+            if (isShutdown) throw RejectedExecutionException("closed")
+            tasks.addLast(task)
+        }
+
+        override fun shutdown() {
+            isShutdown = true
+        }
+
+        fun runAll() {
+            while (tasks.isNotEmpty()) {
+                tasks.removeFirst().run()
+            }
+        }
+
+        fun hasNoQueuedWork(): Boolean = tasks.isEmpty()
+    }
+
+    private companion object {
+        const val NONE: Byte = 0
+        const val LEFT: Byte = 1
+    }
+}
