@@ -0,0 +1,79 @@
+package com.atharok.btremote.domain.entities.remoteInput
+
+/**
+ * A set of pointer buttons encoded as the HID mouse button byte.
+ *
+ * Reports are built from the whole set, never from the one button the current
+ * action cares about: a pointer moving during a drag must keep the left button
+ * down, and a middle click during a drag must not silently release it.
+ */
+@JvmInline
+value class MouseButtons private constructor(val value: Byte) {
+
+    val isEmpty: Boolean get() = value.toInt() == 0
+
+    infix fun with(button: MouseAction): MouseButtons =
+        MouseButtons((value.toInt() or button.byte.toInt()).toByte())
+
+    infix fun without(button: MouseAction): MouseButtons =
+        MouseButtons((value.toInt() and button.byte.toInt().inv()).toByte())
+
+    operator fun contains(button: MouseAction): Boolean =
+        value.toInt() and button.byte.toInt() != 0
+
+    companion object {
+        val NONE = MouseButtons(0)
+
+        fun of(vararg buttons: MouseAction): MouseButtons =
+            buttons.fold(NONE) { held, button -> held with button }
+    }
+}
+
+/**
+ * The pointer buttons the trackpad panel is currently holding.
+ *
+ * The drag is kept apart because it is owned by the gesture recognizer rather
+ * than by a button that is visibly down: every report merges the drag's left
+ * button into the held set instead of replacing it.
+ */
+class MouseButtonState {
+
+    private var held: MouseButtons = MouseButtons.NONE
+    private var isDragging: Boolean = false
+
+    /** The buttons to report right now. */
+    val report: MouseButtons
+        get() = if (isDragging) held with MouseAction.MOUSE_CLICK_LEFT else held
+
+    fun press(button: MouseAction): MouseButtons {
+        held = held with button
+        return report
+    }
+
+    fun release(button: MouseAction): MouseButtons {
+        held = held without button
+        return report
+    }
+
+    fun setDragging(dragging: Boolean): MouseButtons {
+        isDragging = dragging
+        return report
+    }
+
+    /**
+     * One click without losing the other buttons: the clicked button is pressed
+     * on top of the current set and then that same set is sent again. Returns
+     * the two reports so the caller sends them in order.
+     */
+    fun click(button: MouseAction): List<MouseButtons> {
+        val current = report
+        return listOf(current with button, current)
+    }
+
+    /** Drops every held button and the drag, and returns the zero report. */
+    fun reset(): MouseButtons {
+        held = MouseButtons.NONE
+        isDragging = false
+        return MouseButtons.NONE
+    }
+}
