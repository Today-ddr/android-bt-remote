@@ -0,0 +1,96 @@
+package com.atharok.btremote.domain.entities.remoteInput
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class MouseButtonStateTest {
+
+    private val left = MouseAction.MOUSE_CLICK_LEFT
+    private val right = MouseAction.MOUSE_CLICK_RIGHT
+    private val middle = MouseAction.MOUSE_CLICK_MIDDLE
+
+    @Test
+    fun buttonsMergeAndReleaseBitByBit() {
+        val buttons = MouseButtons.NONE with left with middle
+
+        assertTrue(left in buttons)
+        assertTrue(middle in buttons)
+        assertFalse(right in buttons)
+
+        val afterRelease = buttons without left
+        assertFalse(left in afterRelease)
+        assertTrue(middle in afterRelease)
+        assertEquals(0, MouseButtons.NONE.value.toInt())
+        assertTrue(MouseButtons.NONE.isEmpty)
+    }
+
+    @Test
+    fun draggingKeepsTheLeftButtonInEveryReport() {
+        val state = MouseButtonState()
+
+        assertEquals(MouseAction.MOUSE_CLICK_LEFT.byte, state.setDragging(true).value)
+        assertEquals(
+            (MouseAction.MOUSE_CLICK_LEFT.byte.toInt() or MouseAction.MOUSE_CLICK_MIDDLE.byte.toInt()).toByte(),
+            state.press(middle).value
+        )
+    }
+
+    @Test
+    fun releasingMiddleDuringADragKeepsTheDragHeld() {
+        val state = MouseButtonState()
+        state.setDragging(true)
+        state.press(middle)
+
+        val report = state.release(middle)
+
+        assertEquals(MouseAction.MOUSE_CLICK_LEFT.byte, report.value)
+        assertFalse(middle in report)
+    }
+
+    @Test
+    fun aClickDuringADragPulsesOnTopOfTheHeldSet() {
+        val state = MouseButtonState()
+        state.setDragging(true)
+        state.press(middle)
+
+        val reports = state.click(right)
+
+        assertEquals(2, reports.size)
+        assertEquals(
+            MouseAction.MOUSE_CLICK_LEFT.byte.toInt() or
+                MouseAction.MOUSE_CLICK_RIGHT.byte.toInt() or
+                MouseAction.MOUSE_CLICK_MIDDLE.byte.toInt(),
+            reports[0].value.toInt()
+        )
+        // The release report restores both the drag and the middle button.
+        assertEquals(reports[1].value, state.report.value)
+        assertTrue(left in reports[1])
+        assertTrue(middle in reports[1])
+        assertFalse(right in reports[1])
+    }
+
+    @Test
+    fun endingTheDragReleasesOnlyTheLeftButton() {
+        val state = MouseButtonState()
+        state.setDragging(true)
+        state.press(middle)
+
+        val report = state.setDragging(false)
+
+        assertFalse(left in report)
+        assertTrue(middle in report)
+    }
+
+    @Test
+    fun resetDropsTheDragAndEveryButton() {
+        val state = MouseButtonState()
+        state.setDragging(true)
+        state.press(middle)
+
+        assertEquals(MouseButtons.NONE, state.reset())
+        assertTrue(state.report.isEmpty)
+        assertTrue(state.report.value.toInt() == 0)
+    }
+}
