+package com.atharok.btremote.domain.entities.remoteInput.trackpad
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class ScrollStepTest {
+
+    @Test
+    fun theStepNeverCollapsesToZero() {
+        assertEquals(1, ScrollStep.amount(0f))
+        assertEquals(1, ScrollStep.amount(0.25f))
+        assertEquals(3, ScrollStep.amount(1f))
+        assertEquals(15, ScrollStep.amount(5f))
+    }
+
+    @Test
+    fun upIsPositiveAndDownIsNegative() {
+        assertEquals(3f, ScrollStep.wheel(1, 1f, invertScroll = false))
+        assertEquals(-3f, ScrollStep.wheel(-1, 1f, invertScroll = false))
+    }
+
+    @Test
+    fun invertedScrollingFlipsBothDirections() {
+        assertEquals(-3f, ScrollStep.wheel(1, 1f, invertScroll = true))
+        assertEquals(3f, ScrollStep.wheel(-1, 1f, invertScroll = true))
+    }
+}
