@@ -0,0 +1,97 @@
+package com.atharok.btremote.domain.entities.remoteInput.trackpad
+
+import com.atharok.btremote.domain.entities.settings.TrackpadSettings
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TrackpadLongPressTest {
+
+    @Test
+    fun longPressStartsADragAndTheLiftEndsItOnce() {
+        val recognizer = TrackpadGestureRecognizer()
+
+        recognizer.onTouch(touch(0, pointer(0, 10f, 10f)))
+
+        assertEquals(
+            listOf(
+                TrackpadGestureOutput.Haptic(TrackpadHapticEvent.DRAG_START),
+                TrackpadGestureOutput.DragStart
+            ),
+            recognizer.onLongPressTimeout()
+        )
+        assertEquals(
+            listOf(TrackpadGestureOutput.Move(5f, 0f, dragging = true)),
+            recognizer.onTouch(touch(400, pointer(0, 15f, 10f)))
+        )
+        assertEquals(
+            listOf(TrackpadGestureOutput.DragEnd),
+            recognizer.onTouch(touch(500))
+        )
+    }
+
+    @Test
+    fun aSecondFingerBeforeTheTimeoutCancelsThePress() {
+        val recognizer = TrackpadGestureRecognizer()
+
+        recognizer.onTouch(touch(0, pointer(0, 10f, 10f)))
+        recognizer.onTouch(touch(100, pointer(0, 10f, 10f), pointer(1, 40f, 10f)))
+
+        assertTrue(recognizer.onLongPressTimeout().isEmpty())
+    }
+
+    @Test
+    fun movementPastTheAllowanceCancelsThePress() {
+        val recognizer = TrackpadGestureRecognizer()
+
+        recognizer.onTouch(touch(0, pointer(0, 10f, 10f)))
+        recognizer.onTouch(touch(100, pointer(0, 19f, 10f)))
+
+        assertTrue(recognizer.onLongPressTimeout().isEmpty())
+    }
+
+    @Test
+    fun theSettingCanTurnLongPressOff() {
+        val recognizer = TrackpadGestureRecognizer(
+            settings = TrackpadSettings(longPressDragEnabled = false)
+        )
+
+        recognizer.onTouch(touch(0, pointer(0, 10f, 10f)))
+
+        assertTrue(recognizer.onLongPressTimeout().isEmpty())
+    }
+
+    @Test
+    fun aLongPressDragDoesNotAlsoClickOnLift() {
+        val recognizer = TrackpadGestureRecognizer()
+        recognizer.onTouch(touch(0, pointer(0, 10f, 10f)))
+        recognizer.onLongPressTimeout()
+
+        val outputs = recognizer.onTouch(touch(400))
+
+        assertEquals(listOf(TrackpadGestureOutput.DragEnd), outputs)
+        assertTrue(outputs.none { it is TrackpadGestureOutput.Click })
+    }
+
+    @Test
+    fun fiveFingersAreNotRecognized() {
+        val recognizer = TrackpadGestureRecognizer()
+
+        assertTrue(recognizer.onTouch(multiFingerTouch(0, fingerCount = 5)).isEmpty())
+        assertTrue(recognizer.onTouch(touch(100)).isEmpty())
+    }
+
+    private fun multiFingerTouch(time: Long, fingerCount: Int): TrackpadTouch =
+        touch(
+            time,
+            *List(fingerCount) { index ->
+                pointer(index.toLong(), 50f + index * 20f, 50f)
+            }.toTypedArray()
+        )
+
+    private fun touch(time: Long, vararg pointers: TrackpadPointer): TrackpadTouch =
+        TrackpadTouch(pointers.toList(), time)
+
+    private fun pointer(id: Long, x: Float, y: Float): TrackpadPointer =
+        TrackpadPointer(id, x, y)
+}
