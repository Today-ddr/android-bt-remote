+package com.atharok.btremote.domain.entities.remoteInput
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class InputReleaseCoordinatorTest {
+
+    @Test
+    fun releasesRunInRegistrationOrder() {
+        val coordinator = InputReleaseCoordinator()
+        val order = mutableListOf<String>()
+        coordinator.register { order += "keyboard" }
+        coordinator.register { order += "trackpad" }
+
+        coordinator.releaseAll()
+
+        assertEquals(listOf("keyboard", "trackpad"), order)
+    }
+
+    @Test
+    fun unregisteredReleasesDoNotRun() {
+        val coordinator = InputReleaseCoordinator()
+        var calls = 0
+        val unregister = coordinator.register { calls += 1 }
+        unregister()
+
+        coordinator.releaseAll()
+
+        assertEquals(0, calls)
+    }
+
+    @Test
+    fun repeatedReleaseDoesNotProduceASecondButtonTransition() {
+        val coordinator = InputReleaseCoordinator()
+        var leftButtonDown = true
+        var transitions = 0
+        coordinator.register {
+            if (leftButtonDown) {
+                leftButtonDown = false
+                transitions += 1
+            }
+        }
+
+        coordinator.releaseAll()
+        coordinator.releaseAll()
+
+        assertEquals(1, transitions)
+        assertTrue(!leftButtonDown)
+    }
+}
