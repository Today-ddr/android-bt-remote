+package com.atharok.btremote.ui.navigation
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class AppOrientationPolicyTest {
+
+    @Test
+    fun onlyTheInputDestinationIsLandscape() {
+        assertEquals(
+            AppScreenOrientation.LANDSCAPE,
+            AppOrientationPolicy.orientationFor(AppNavDestination.InputDestination.route)
+        )
+        assertEquals(
+            AppScreenOrientation.PORTRAIT,
+            AppOrientationPolicy.orientationFor(AppNavDestination.DeviceSelectionDestination.route)
+        )
+        assertEquals(
+            AppScreenOrientation.PORTRAIT,
+            AppOrientationPolicy.orientationFor(AppNavDestination.SettingsDestination.route)
+        )
+        assertEquals(
+            AppScreenOrientation.PORTRAIT,
+            AppOrientationPolicy.orientationFor(AppNavDestination.BluetoothPermissionsDestination.route)
+        )
+        assertEquals(AppScreenOrientation.PORTRAIT, AppOrientationPolicy.orientationFor(null))
+    }
+}
