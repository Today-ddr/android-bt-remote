+                text = { TextNormal(text = stringResource(id = R.string.connection)) },
+                leadingIcon = {
+                    Icon(imageVector = AppIcons.Bluetooth, contentDescription = null)
+                },
+                onClick = {
+                    expanded = false
+                    onConnect()
+                }
+            )
+            DropdownMenuItem(
+                text = { TextNormal(text = stringResource(id = R.string.settings)) },
+                leadingIcon = {
+                    Icon(imageVector = AppIcons.Settings, contentDescription = null)
+                },
+                onClick = {
+                    expanded = false
+                    onSettings()
+                }
+            )
+        }
+    }
+}
+
+@Composable
+private fun NotConnectedView(
+    onOpenConnection: () -> Unit,
+    modifier: Modifier = Modifier
+) {
+    Column(
+        modifier = modifier
+            .fillMaxSize()
+            .windowInsetsPadding(WindowInsets.systemBars)
+            .padding(40.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+        verticalArrangement = Arrangement.Center
+    ) {
+        Icon(
+            imageVector = AppIcons.Keyboard,
+            contentDescription = null,
+            modifier = Modifier.size(56.dp),
+            tint = MaterialTheme.colorScheme.onSurfaceVariant
+        )
+        Spacer(modifier = Modifier.height(16.dp))
+        Text(
+            text = stringResource(id = R.string.input_not_connected_title),
+            style = MaterialTheme.typography.titleLarge,
+            fontWeight = FontWeight.SemiBold
+        )
+        Spacer(modifier = Modifier.height(8.dp))
+        Text(
+            text = stringResource(id = R.string.input_not_connected_message),
+            style = MaterialTheme.typography.bodyMedium,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            textAlign = TextAlign.Center
+        )
+        Spacer(modifier = Modifier.height(16.dp))
+        Button(onClick = onOpenConnection) {
+            Text(text = stringResource(id = R.string.open_connection_page))
+        }
+    }
+}
+
+private fun InputPage.icon(): ImageVector = when (this) {
+    InputPage.KEYBOARD -> AppIcons.Keyboard
+    InputPage.TRACKPAD -> AppIcons.Mouse
+}
+
+private fun InputPage.labelRes(): Int = when (this) {
+    InputPage.KEYBOARD -> R.string.keyboard
+    InputPage.TRACKPAD -> R.string.touchpad
+}
