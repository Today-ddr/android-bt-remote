diff --git a/app/src/main/java/com/atharok/btremote/domain/entities/remoteInput/InputReleaseCoordinator.kt b/app/src/main/java/com/atharok/btremote/domain/entities/remoteInput/InputReleaseCoordinator.kt
new file mode 100644
index 0000000..88ba1c7
--- /dev/null
+++ b/app/src/main/java/com/atharok/btremote/domain/entities/remoteInput/InputReleaseCoordinator.kt
@@ -0,0 +1,30 @@
+package com.atharok.btremote.domain.entities.remoteInput
+
+/**
+ * One place that can end every piece of input state the app is holding.
+ *
+ * The keyboard and the trackpad register a release for as long as their page is
+ * composed. Page changes, backgrounding, disconnection and teardown all run the
+ * same path, and each registered release is written to be safe to call again: a
+ * second release while nothing is held changes no state and therefore cannot
+ * produce a second button transition.
+ *
+ * Registrations are kept in insertion order and only touched from the main
+ * thread.
+ */
+class InputReleaseCoordinator {
+
+    private val releases = linkedMapOf<Long, () -> Unit>()
+    private var nextId = 0L
+
+    /** Returns the function that removes this registration again. */
+    fun register(release: () -> Unit): () -> Unit {
+        val id = nextId++
+        releases[id] = release
+        return { releases.remove(id) }
+    }
+
+    fun releaseAll() {
+        releases.values.toList().forEach { release -> release() }
+    }
+}
