+package com.atharok.btremote.ui.views.mouse
+
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxHeight
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.material3.Icon
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.RectangleShape
+import androidx.compose.ui.graphics.Shape
+import androidx.compose.ui.graphics.vector.ImageVector
+import androidx.compose.ui.res.dimensionResource
+import androidx.compose.ui.res.stringResource
+import com.atharok.btremote.R
+import com.atharok.btremote.common.utils.AppIcons
+import com.atharok.btremote.domain.entities.remoteInput.InputReleaseCoordinator
+import com.atharok.btremote.domain.entities.remoteInput.MouseAction
+import com.atharok.btremote.domain.entities.remoteInput.trackpad.ScrollStep
+import com.atharok.btremote.domain.entities.settings.RemoteSettings
+import com.atharok.btremote.domain.entities.settings.TrackpadSettings
+import com.atharok.btremote.ui.components.customButtons.SurfaceButton
+import com.atharok.btremote.ui.haptics.LocalHapticActions
+
+/**
+ * The full-screen trackpad page: the gesture surface plus the right-side
+ * Up / middle-click / Down column. Left and right clicks come from the surface
+ * itself, so no separate button row is needed.
+ */
+@Composable
+fun TrackpadPage(
+    remoteSettings: RemoteSettings,
+    trackpadSettings: TrackpadSettings,
+    sendMouseInput: (MouseAction, Float, Float, Float) -> Unit,
+    sendKeyboardReport: (ByteArray) -> Unit,
+    releaseCoordinator: InputReleaseCoordinator,
+    modifier: Modifier = Modifier
+) {
+    val hapticActions = LocalHapticActions.current
+
+    Row(modifier = modifier) {
+        MacTrackpad(
+            mouseSpeed = remoteSettings.mouseSpeed,
+            scrollSpeed = remoteSettings.mouseScrollSpeed,
+            shouldInvertMouseScrollingDirection = remoteSettings.shouldInvertMouseScrollingDirection,
+            trackpadSettings = trackpadSettings,
+            sendMouseInput = sendMouseInput,
+            sendKeyboardReport = sendKeyboardReport,
+            releaseCoordinator = releaseCoordinator,
+            shape = RoundedCornerShape(dimensionResource(id = R.dimen.card_corner_radius)),
+            modifier = Modifier
+                .weight(0.85f)
+                .fillMaxHeight()
+                .padding(end = dimensionResource(id = R.dimen.padding_min))
+        )
+
+        Column(
+            modifier = Modifier
+                .weight(0.15f)
+                .fillMaxHeight()
+        ) {
+            ScrollButton(
+                icon = AppIcons.MouseScrollUp,
+                contentDescription = stringResource(id = R.string.mouse_wheel_up),
+                direction = 1,
+                scrollSpeed = remoteSettings.mouseScrollSpeed,
+                invertScroll = remoteSettings.shouldInvertMouseScrollingDirection,
+                sendMouseInput = sendMouseInput,
+                onHaptic = hapticActions.scrollTick,
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .weight(1f)
+                    .padding(bottom = dimensionResource(id = R.dimen.padding_min)),
+                shape = RoundedCornerShape(dimensionResource(id = R.dimen.card_corner_radius))
+            )
+
+            SurfaceButton(
+                touchDown = {
+                    hapticActions.trackpadTap()
+                    sendMouseInput(MouseAction.MOUSE_CLICK_MIDDLE, 0f, 0f, 0f)
+                },
+                touchUp = {
+                    sendMouseInput(MouseAction.NONE, 0f, 0f, 0f)
+                },
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .weight(1f)
+                    .padding(vertical = dimensionResource(id = R.dimen.padding_min)),
+                shape = RectangleShape
+            ) {
+                Icon(
+                    imageVector = AppIcons.Mouse,
+                    contentDescription = stringResource(id = R.string.mouse_click_middle)
+                )
+            }
+
+            ScrollButton(
+                icon = AppIcons.MouseScrollDown,
+                contentDescription = stringResource(id = R.string.mouse_wheel_down),
+                direction = -1,
+                scrollSpeed = remoteSettings.mouseScrollSpeed,
+                invertScroll = remoteSettings.shouldInvertMouseScrollingDirection,
+                sendMouseInput = sendMouseInput,
+                onHaptic = hapticActions.scrollTick,
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .weight(1f)
+                    .padding(top = dimensionResource(id = R.dimen.padding_min)),
+                shape = RoundedCornerShape(dimensionResource(id = R.dimen.card_corner_radius))
+            )
+        }
+    }
+}
+
+@Composable
+private fun ScrollButton(
+    icon: ImageVector,
+    contentDescription: String,
+    direction: Int,
+    scrollSpeed: Float,
+    invertScroll: Boolean,
+    sendMouseInput: (MouseAction, Float, Float, Float) -> Unit,
+    onHaptic: () -> Unit,
+    modifier: Modifier,
+    shape: Shape
+) {
+    SurfaceButton(
+        touchDown = {
+            sendMouseInput(
+                MouseAction.NONE,
+                0f,
+                0f,
+                ScrollStep.wheel(
+                    direction = direction,
+                    scrollSpeed = scrollSpeed,
+                    invertScroll = invertScroll
+                )
+            )
+            onHaptic()
+        },
+        touchUp = {},
+        modifier = modifier,
+        shape = shape
+    ) {
+        Icon(
+            imageVector = icon,
+            contentDescription = contentDescription
+        )
+    }
+}
