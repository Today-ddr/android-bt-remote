@@ -0,0 +1,23 @@
+package com.atharok.btremote.domain.entities.remoteInput.trackpad
+
+import kotlin.math.roundToInt
+
+/**
+ * The step the right-side Up and Down buttons send.
+ *
+ * One tap is one small relative wheel report. The value never collapses to zero,
+ * so a tap always moves the host, and the natural / inverted preference is applied
+ * at the same place that decides the direction.
+ */
+object ScrollStep {
+
+    fun amount(scrollSpeed: Float): Int =
+        maxOf(1, (3f * scrollSpeed).roundToInt().coerceIn(1, 127))
+
+    /** [direction] is +1 for Up and -1 for Down. */
+    fun wheel(direction: Int, scrollSpeed: Float, invertScroll: Boolean): Float {
+        val amount = amount(scrollSpeed)
+        val base = if (direction < 0) -amount else amount
+        return (if (invertScroll) -base else base).toFloat()
+    }
+}
