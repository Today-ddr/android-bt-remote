+    @Test
+    fun liftingAllPointersClearsTwoFingerOwnershipForTheNextGesture() {
+        val recognizer = TrackpadGestureRecognizer()
+
+        recognizer.onTouch(twoFingerTouch(0, leftX = 50f, rightX = 100f))
+        recognizer.onTouch(twoFingerTouch(40, leftX = 50f, rightX = 100f, y = 62f))
+        recognizer.onTouch(touch(80))
+
+        recognizer.onTouch(twoFingerTouch(200, leftX = 50f, rightX = 100f))
+        assertEquals(
+            listOf(
+                TrackpadGestureOutput.Haptic(TrackpadHapticEvent.CLICK),
