+package com.atharok.btremote.domain.entities.remoteInput.trackpad
+
+import com.atharok.btremote.domain.entities.remoteInput.MouseAction
+import com.atharok.btremote.domain.entities.settings.TrackpadSettings
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.math.cos
+import kotlin.math.sin
+
+class TrackpadGestureRecognizerTest {
+
+    @Test
+    fun oneFingerTapEmitsLeftClickAndHaptic() {
+        val recognizer = TrackpadGestureRecognizer()
+
+        assertTrue(recognizer.onTouch(touch(0, pointer(0, 10f, 10f))).isEmpty())
+        assertEquals(
+            listOf(
+                TrackpadGestureOutput.Haptic(TrackpadHapticEvent.CLICK),
+                TrackpadGestureOutput.Click(MouseAction.MOUSE_CLICK_LEFT)
+            ),
+            recognizer.onTouch(touch(80))
+        )
+    }
+
+    @Test
+    fun oneFingerMovePastTheTapSlopEmitsMovementButNeverClicks() {
+        val recognizer = TrackpadGestureRecognizer()
+
+        recognizer.onTouch(touch(0, pointer(0, 10f, 10f)))
+
+        val outputs = recognizer.onTouch(touch(80, pointer(0, 30f, 20f)))
+
+        assertEquals(
+            listOf(TrackpadGestureOutput.Move(20f, 10f, dragging = false)),
+            outputs
+        )
+        assertTrue(recognizer.onTouch(touch(120)).isEmpty())
+    }
+
+    @Test
+    fun doubleTapThenMovePressesDragsAndReleases() {
+        val recognizer = TrackpadGestureRecognizer()
+
+        recognizer.onTouch(touch(0, pointer(0, 10f, 10f)))
+        recognizer.onTouch(touch(50))
+        recognizer.onTouch(touch(100, pointer(0, 11f, 11f)))
+
+        assertEquals(
+            listOf(
+                TrackpadGestureOutput.Haptic(TrackpadHapticEvent.DRAG_START),
+                TrackpadGestureOutput.DragStart,
+                TrackpadGestureOutput.Move(20f, 10f, dragging = true)
+            ),
+            recognizer.onTouch(touch(130, pointer(0, 31f, 21f)))
+        )
+        assertEquals(
+            listOf(TrackpadGestureOutput.DragEnd),
+            recognizer.onTouch(touch(160))
+        )
+    }
+
+    @Test
+    fun twoFingerTapEmitsRightClickAndHaptic() {
+        val recognizer = TrackpadGestureRecognizer()
+
+        recognizer.onTouch(
+            touch(
+                0,
+                pointer(0, 50f, 50f),
+                pointer(1, 100f, 50f)
+            )
+        )
+
+        assertEquals(
+            listOf(
+                TrackpadGestureOutput.Haptic(TrackpadHapticEvent.CLICK),
+                TrackpadGestureOutput.Click(MouseAction.MOUSE_CLICK_RIGHT)
+            ),
+            recognizer.onTouch(touch(100))
+        )
+    }
+
+    @Test
+    fun twoFingerScrollReportsAmountAndRespectsInversion() {
+        val normal = TrackpadGestureRecognizer()
+        val inverted = TrackpadGestureRecognizer(invertScroll = true)
+
+        normal.onTouch(twoFingerTouch(0, y = 50f))
+        inverted.onTouch(twoFingerTouch(0, y = 50f))
+
+        assertEquals(
+            listOf(
+                TrackpadGestureOutput.Haptic(TrackpadHapticEvent.SCROLL),
+                TrackpadGestureOutput.Scroll(-2)
+            ),
+            normal.onTouch(twoFingerTouch(40, y = 62f))
+        )
+        assertEquals(
+            listOf(
+                TrackpadGestureOutput.Haptic(TrackpadHapticEvent.SCROLL),
+                TrackpadGestureOutput.Scroll(2)
+            ),
+            inverted.onTouch(twoFingerTouch(40, y = 62f))
