+    @Test
+    fun rotationActsOnlyWhileTwoFingerOwnershipIsIdle() {
+        val idleOwner = TrackpadGestureRecognizer()
+        idleOwner.onTouch(rotatedTwoFingerTouch(0, angleRadians = 0f))
+        assertTrue(
+            idleOwner.onTouch(rotatedTwoFingerTouch(20, angleRadians = 0.10f))
+                .none { it is TrackpadGestureOutput.Rotate }
+        )
+        assertTrue(
+            idleOwner.onTouch(rotatedTwoFingerTouch(40, angleRadians = 0.30f))
+                .none { it is TrackpadGestureOutput.Scroll }
+        )
+        assertTrue(
+            idleOwner.onTouch(
+                rotatedTwoFingerTouch(
+                    time = 60,
+                    angleRadians = 0.30f,
+                    centerX = 120f,
+                    centerY = 150f
+                )
+            ).none { it is TrackpadGestureOutput.Scroll }
+        )
+        val idleEnd = idleOwner.onTouch(touch(100))
+        assertEquals(1, idleEnd.count { it is TrackpadGestureOutput.Rotate })
+        assertTrue(idleEnd.none { it is TrackpadGestureOutput.Scroll })
+
+        val scrollOwner = TrackpadGestureRecognizer()
+        scrollOwner.onTouch(twoFingerTouch(0, leftX = 50f, rightX = 100f))
+        scrollOwner.onTouch(twoFingerTouch(40, leftX = 50f, rightX = 100f, y = 62f))
+        assertTrue(
+            scrollOwner.onTouch(rotatedTwoFingerTouch(60, angleRadians = 0.40f))
+                .none { it is TrackpadGestureOutput.Rotate }
+        )
+        assertTrue(
+            scrollOwner.onTouch(touch(100))
+                .none { it is TrackpadGestureOutput.Rotate }
+        )
+    }
