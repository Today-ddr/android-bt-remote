+    @Test
+    fun threeAndFourFingerSwipesMapEveryDirection() {
+        val cases = listOf(
+            SwipeCase(3, dx = 0f, dy = -60f, expected = TrackpadGestureAction.APP_SWITCHER),
+            SwipeCase(3, dx = 0f, dy = 60f, expected = TrackpadGestureAction.HOME),
+            SwipeCase(3, dx = -60f, dy = 0f, expected = TrackpadGestureAction.PREVIOUS_APP),
+            SwipeCase(3, dx = 60f, dy = 0f, expected = TrackpadGestureAction.NEXT_APP),
+            SwipeCase(4, dx = 0f, dy = -60f, expected = TrackpadGestureAction.MISSION_CONTROL),
+            SwipeCase(4, dx = 0f, dy = 60f, expected = TrackpadGestureAction.APP_EXPOSE),
+            SwipeCase(4, dx = -60f, dy = 0f, expected = TrackpadGestureAction.SWITCH_SPACE_LEFT),
+            SwipeCase(4, dx = 60f, dy = 0f, expected = TrackpadGestureAction.SWITCH_SPACE_RIGHT)
+        )
+
+        cases.forEach { case ->
+            val recognizer = TrackpadGestureRecognizer()
+            val start = multiFingerTouch(0, case.fingerCount)
+            recognizer.onTouch(start)
+            assertTrue(
+                recognizer.onTouch(
+                    multiFingerTouch(
+                        50,
+                        case.fingerCount,
+                        dx = case.dx,
+                        dy = case.dy
+                    )
+                ).isEmpty()
+            )
+            assertEquals(
+                case.toString(),
+                listOf(
+                    TrackpadGestureOutput.Haptic(TrackpadHapticEvent.GESTURE),
+                    TrackpadGestureOutput.Action(case.expected)
+                ),
+                recognizer.onTouch(touch(100))
+            )
+        }
+    }
