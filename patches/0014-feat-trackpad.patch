+
+    private fun spreadTo(
+        recognizer: TrackpadGestureRecognizer,
+        time: Long,
+        leftX: Float,
+        rightX: Float
+    ) {
+        assertTrue(
+            recognizer.onTouch(
+                twoFingerTouch(
+                    time,
+                    leftX = leftX,
+                    rightX = rightX
+                )
+            ).isEmpty()
+        )
+    }
+
+    private fun twoFingerTouch(
+        time: Long,
+        leftX: Float = 50f,
+        rightX: Float = 100f,
+        y: Float = 50f
+    ): TrackpadTouch = touch(
+        time,
+        pointer(0, leftX, y),
+        pointer(1, rightX, y)
+    )
+
+    private fun rotatedTwoFingerTouch(
+        time: Long,
+        angleRadians: Float,
+        centerX: Float = 100f,
+        centerY: Float = 100f
+    ): TrackpadTouch {
+        val radius = 20f
+        val dx = cos(angleRadians) * radius
+        val dy = sin(angleRadians) * radius
+        return touch(
+            time,
+            pointer(0, centerX - dx, centerY - dy),
+            pointer(1, centerX + dx, centerY + dy)
+        )
+    }
+
+    private fun multiFingerTouch(
+        time: Long,
+        fingerCount: Int,
+        dx: Float = 0f,
+        dy: Float = 0f
+    ): TrackpadTouch = touch(
+        time,
+        *List(fingerCount) { index ->
+            pointer(
+                id = index.toLong(),
+                x = 80f + index * 30f + dx,
+                y = 100f + dy
+            )
+        }.toTypedArray()
+    )
+
+    private fun touch(time: Long, vararg pointers: TrackpadPointer): TrackpadTouch =
+        TrackpadTouch(pointers.toList(), time)
+
+    private fun pointer(id: Long, x: Float, y: Float): TrackpadPointer =
+        TrackpadPointer(id, x, y)
+
+    private data class SwipeCase(
+        val fingerCount: Int,
+        val dx: Float,
+        val dy: Float,
+        val expected: TrackpadGestureAction
+    )
+}
