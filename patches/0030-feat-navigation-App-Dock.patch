+/**
+ * The portrait navigation capsule modelled on the iOS AppDock: one entry per
+ * root page, the current one highlighted, and the whole bar inset from the
+ * screen edges.
+ *
+ * It is used as a Scaffold bottom bar, so it never covers the page content.
+ */
+@Composable
+fun AppDock(
+    selectedTab: AppMainTab,
+    onSelectTab: (AppMainTab) -> Unit,
+    modifier: Modifier = Modifier
+) {
+    val hapticFeedback = LocalHapticFeedback.current
+
+    Box(
+        modifier = modifier
+            .fillMaxWidth()
+            .windowInsetsPadding(WindowInsets.navigationBars)
+            .padding(horizontal = 12.dp, vertical = 4.dp),
+        contentAlignment = Alignment.Center
+    ) {
+        Surface(
+            shape = RoundedCornerShape(percent = 50),
+            color = MaterialTheme.colorScheme.surfaceColorAtElevation(surfaceElevationLow()),
+            tonalElevation = surfaceElevationLow()
+        ) {
+            Row(
+                modifier = Modifier
+                    .widthIn(max = 520.dp)
+                    .padding(5.dp),
+                horizontalArrangement = Arrangement.spacedBy(4.dp)
+            ) {
+                AppMainTab.entries.forEach { tab ->
+                    DockItem(
+                        tab = tab,
+                        selected = tab == selectedTab,
+                        onClick = {
+                            hapticFeedback.performHapticFeedback(HapticFeedbackType.LongPress)
+                            onSelectTab(tab)
+                        },
+                        modifier = Modifier.weight(1f)
+                    )
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun DockItem(
+    tab: AppMainTab,
+    selected: Boolean,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier
+) {
+    val accent = MaterialTheme.colorScheme.primary
+    Column(
+        modifier = modifier
+            .clip(RoundedCornerShape(dimensionResource(id = R.dimen.card_corner_radius)))
+            .background(if (selected) accent.copy(alpha = 0.16f) else Color.Transparent)
+            .clickable(onClick = onClick)
+            .padding(vertical = 6.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+        verticalArrangement = Arrangement.spacedBy(3.dp)
+    ) {
+        Icon(
+            imageVector = tab.icon(),
+            contentDescription = null,
+            modifier = Modifier.size(20.dp),
+            tint = if (selected) accent else MaterialTheme.colorScheme.onSurfaceVariant
+        )
+        Text(
+            text = stringResource(id = tab.labelRes()),
+            fontSize = 10.sp,
+            fontWeight = FontWeight.SemiBold,
+            color = if (selected) accent else MaterialTheme.colorScheme.onSurfaceVariant,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis
+        )
+    }
+}
+
+private fun AppMainTab.icon(): ImageVector = when (this) {
+    AppMainTab.CONNECT -> AppIcons.Bluetooth
+    AppMainTab.INPUT -> AppIcons.Input
+    AppMainTab.SETTINGS -> AppIcons.Settings
+}
+
+private fun AppMainTab.labelRes(): Int = when (this) {
+    AppMainTab.CONNECT -> R.string.connection
+    AppMainTab.INPUT -> R.string.input
+    AppMainTab.SETTINGS -> R.string.settings
+}
