+package com.atharok.btremote.ui.navigation
+
+/** The three root entries of the dock. */
+enum class AppMainTab(val route: String) {
+    CONNECT(AppNavDestination.DeviceSelectionDestination.route),
+    INPUT(AppNavDestination.InputDestination.route),
+    SETTINGS(AppNavDestination.SettingsDestination.route)
+}
+
+/**
+ * The dock is the portrait navigation for the two main pages.
+ *
+ * The input page is landscape-only and draws its own toolbar, and the
+ * permission, activation, discovery, pairing and settings sub-pages are
+ * one-way flows that keep their own back navigation.
+ */
+object DockVisibilityPolicy {
+
+    fun showsDock(isLandscape: Boolean, route: String?): Boolean {
+        if (isLandscape) return false
+        return route == AppNavDestination.DeviceSelectionDestination.route ||
+            route == AppNavDestination.SettingsDestination.route
+    }
+}
