+
+/**
+ * Moves to a dock page by reusing the copy already on the back stack.
+ *
+ * Popping to an existing entry keeps the stack from growing a second Settings
+ * or a second device page when the dock is used repeatedly. When the page is
+ * not on the stack, a normal navigation pushes it.
+ */
+fun NavHostController.navigateToMainTab(tab: AppMainTab) {
+    if (currentDestination?.route == tab.route) {
+        return
+    }
+    if (!popBackStack(tab.route, inclusive = false)) {
+        navigateTo(tab.route)
+    }
+}
