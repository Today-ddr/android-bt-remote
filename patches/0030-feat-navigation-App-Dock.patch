+package com.atharok.btremote.ui.navigation
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class DockVisibilityPolicyTest {
+
+    private val devices = AppNavDestination.DeviceSelectionDestination.route
+    private val settings = AppNavDestination.SettingsDestination.route
+    private val input = AppNavDestination.InputDestination.route
+
+    @Test
+    fun dockShowsOnTheTwoMainPortraitPages() {
+        assertTrue(DockVisibilityPolicy.showsDock(isLandscape = false, route = devices))
+        assertTrue(DockVisibilityPolicy.showsDock(isLandscape = false, route = settings))
+    }
+
+    @Test
+    fun dockHidesOnTheInputPageLandscapeOrNot() {
+        assertFalse(DockVisibilityPolicy.showsDock(isLandscape = true, route = input))
+        assertFalse(DockVisibilityPolicy.showsDock(isLandscape = false, route = input))
+    }
+
+    @Test
+    fun dockHidesOnPermissionActivationDiscoveryAndSettingsSubPages() {
+        val hiddenRoutes = listOf(
+            AppNavDestination.BluetoothPermissionsDestination.route,
+            AppNavDestination.BluetoothActivationDestination.route,
+            AppNavDestination.DeviceDiscoveryDestination.route,
+            AppNavDestination.DistantDevicePairDestination.route,
+            AppNavDestination.TrackpadGestureSettingsDestination.route,
+            AppNavDestination.ThirdLibrariesDestination.route,
+            null
+        )
+
+        hiddenRoutes.forEach { route ->
+            assertFalse("$route", DockVisibilityPolicy.showsDock(isLandscape = false, route = route))
+        }
+    }
+
+    @Test
+    fun dockHidesInLandscapeEvenOnAMainPage() {
+        assertFalse(DockVisibilityPolicy.showsDock(isLandscape = true, route = devices))
+        assertFalse(DockVisibilityPolicy.showsDock(isLandscape = true, route = settings))
+    }
+
+    @Test
+    fun dockTabsPointAtTheThreeRootDestinations() {
+        assertEquals(devices, AppMainTab.CONNECT.route)
+        assertEquals(input, AppMainTab.INPUT.route)
+        assertEquals(settings, AppMainTab.SETTINGS.route)
+        assertEquals(3, AppMainTab.entries.size)
+    }
+}
