+package com.atharok.btremote.common.utils
+
+/**
+ * Which host requests this app can answer, kept free of Android types so the
+ * support matrix can be unit tested without a device or a host.
+ *
+ * The report types are the HID spec values that `BluetoothHidDevice` also
+ * exposes (`REPORT_TYPE_INPUT` = 0x01, `REPORT_TYPE_OUTPUT` = 0x02).
+ */
+internal object HidReportSupport {
+
+    const val REPORT_TYPE_INPUT: Byte = 0x01
+    const val REPORT_TYPE_OUTPUT: Byte = 0x02
+
+    /**
+     * Some host stacks write the LED report unnumbered even though the
+     * descriptor gives it report ID 3, so both IDs are accepted on SET_REPORT.
+     */
+    const val UNNUMBERED_REPORT_ID: Int = 0
+
+    /**
+     * SET_REPORT is only valid for the keyboard LED output report: it is the
+     * only output report in the descriptor.
+     *
+     * An empty payload is rejected. The descriptor declares one data byte, so a
+     * zero-length report carries no LED state at all and cannot be parsed; the
+     * request is answered with an error instead of pretending it succeeded.
+     */
+    fun isSupportedSetReport(type: Byte, id: Byte, data: ByteArray?): Boolean {
+        val reportId = id.toInt()
+        return type == REPORT_TYPE_OUTPUT &&
+            (reportId == KEYBOARD_LED_REPORT_ID || reportId == UNNUMBERED_REPORT_ID) &&
+            data != null && data.isNotEmpty()
+    }
+
+    /**
+     * GET_REPORT is answerable for the reports this app actually produces: the
+     * last mouse or keyboard input report, and the current LED output state.
+     *
+     * Report ID 0 is not declared in the descriptor, so unlike SET_REPORT it is
+     * not accepted here; an undeclared ID cannot be requested by a conforming
+     * host.
+     */
+    fun supportedGetReport(type: Byte, id: Byte): HidGetReport? {
+        val reportId = id.toInt()
+        return when (type) {
+            REPORT_TYPE_INPUT -> when (reportId) {
+                MOUSE_REPORT_ID -> HidGetReport.MOUSE_INPUT
+                KEYBOARD_REPORT_ID -> HidGetReport.KEYBOARD_INPUT
+                else -> null
+            }
+
+            REPORT_TYPE_OUTPUT -> when (reportId) {
+                KEYBOARD_LED_REPORT_ID -> HidGetReport.KEYBOARD_LED
+                else -> null
+            }
+
+            else -> null
+        }
+    }
+}
+
+/** The report a GET_REPORT request resolves to, or none when it is unsupported. */
+internal enum class HidGetReport {
+    MOUSE_INPUT,
+    KEYBOARD_INPUT,
+    KEYBOARD_LED
+}
