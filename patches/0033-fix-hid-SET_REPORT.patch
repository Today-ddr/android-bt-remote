+package com.atharok.btremote.common.utils
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Numeric literals are used on purpose: these are the values of
+ * `BluetoothHidDevice.REPORT_TYPE_*` and the report IDs, so the tests stay on
+ * the JVM without touching the Android SDK.
+ */
+class HidReportSupportTest {
+
+    private val outputType = 0x02.toByte()
+    private val inputType = 0x01.toByte()
+    private val featureType = 0x03.toByte()
+
+    private val ledByte = byteArrayOf(0x02)
+
+    // ---- SET_REPORT: keyboard LED output ----
+
+    @Test
+    fun supportsTheLedOutputReport() {
+        assertTrue(HidReportSupport.isSupportedSetReport(outputType, 0x03, ledByte))
+    }
+
+    @Test
+    fun supportsTheUnnumberedLedOutputReport() {
+        assertTrue(HidReportSupport.isSupportedSetReport(outputType, 0x00, ledByte))
+    }
+
+    @Test
+    fun supportsALedOutputReportThatCarriesTheReportIdFirst() {
+        assertTrue(HidReportSupport.isSupportedSetReport(outputType, 0x03, byteArrayOf(0x03, 0x02)))
+    }
+
+    @Test
+    fun rejectsEveryOtherReportType() {
+        assertFalse(HidReportSupport.isSupportedSetReport(inputType, 0x03, ledByte))
+        assertFalse(HidReportSupport.isSupportedSetReport(featureType, 0x03, ledByte))
+    }
+
+    @Test
+    fun rejectsTheWrongReportId() {
+        assertFalse(HidReportSupport.isSupportedSetReport(outputType, 0x01, ledByte))
+        assertFalse(HidReportSupport.isSupportedSetReport(outputType, 0x02, ledByte))
+        assertFalse(HidReportSupport.isSupportedSetReport(outputType, 0x04, ledByte))
+    }
+
+    @Test
+    fun rejectsAMissingOrEmptyPayload() {
+        assertFalse(HidReportSupport.isSupportedSetReport(outputType, 0x03, null))
+        assertFalse(HidReportSupport.isSupportedSetReport(outputType, 0x00, null))
+        assertFalse(HidReportSupport.isSupportedSetReport(outputType, 0x03, ByteArray(0)))
+        assertFalse(HidReportSupport.isSupportedSetReport(outputType, 0x00, ByteArray(0)))
+    }
+
+    // ---- GET_REPORT ----
+
+    @Test
+    fun answersTheReportsTheAppProduces() {
+        assertEquals(HidGetReport.MOUSE_INPUT, HidReportSupport.supportedGetReport(inputType, 0x01))
+        assertEquals(HidGetReport.KEYBOARD_INPUT, HidReportSupport.supportedGetReport(inputType, 0x02))
+        assertEquals(HidGetReport.KEYBOARD_LED, HidReportSupport.supportedGetReport(outputType, 0x03))
+    }
+
+    @Test
+    fun rejectsUnsupportedGetReportTypes() {
+        assertNull(HidReportSupport.supportedGetReport(featureType, 0x03))
+        assertNull(HidReportSupport.supportedGetReport(featureType, 0x01))
+    }
+
+    @Test
+    fun rejectsUnsupportedGetReportIds() {
+        assertNull(HidReportSupport.supportedGetReport(inputType, 0x00))
+        assertNull(HidReportSupport.supportedGetReport(inputType, 0x03))
+        assertNull(HidReportSupport.supportedGetReport(outputType, 0x00))
+        assertNull(HidReportSupport.supportedGetReport(outputType, 0x01))
+    }
+}
