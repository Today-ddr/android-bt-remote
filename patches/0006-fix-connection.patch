+        isAppForeground = isForeground
+    }
+
     fun startBluetoothHidProfile(autoConnectDeviceAddress: String) {
         this.autoConnectDeviceAddress = autoConnectDeviceAddress
+
+        val existingHidDevice = bluetoothHidDevice
+        if (existingHidDevice != null) {
+            if (_isBluetoothHidProfileRegistered.value &&
+                isAppForeground &&
+                isMacAddress(autoConnectDeviceAddress)
+            ) {
+                connectDevice(existingHidDevice, autoConnectDeviceAddress)
+            }
+            return
+        }
+
         adapter?.getProfileProxy(context, serviceListener, BluetoothProfile.HID_DEVICE)
     }
 
