+package com.atharok.btremote.domain.entities.remoteInput.keyboard.mac
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class KeyboardGridMetricsTest {
+
+    private val width = 1450f
+    private val gap = 4f
+
+    @Test
+    fun unitWidthDividesTheGridIntoFourteenAndAHalfColumns() {
+        assertEquals(100f, KeyboardGridMetrics.unitWidth(width), 0.001f)
+        assertEquals(0f, KeyboardGridMetrics.unitWidth(0f), 0.001f)
+        assertEquals(0f, KeyboardGridMetrics.unitWidth(-10f), 0.001f)
+    }
+
+    @Test
+    fun everyOneUnitKeyIsTheSameWidthRegardlessOfRowKeyCount() {
+        val oneUnit = KeyboardGridMetrics.slotWidth(1f, width, gap)
+
+        assertEquals(96f, oneUnit, 0.001f)
+
+        // Dividing the remaining width per row instead would give the 14-key
+        // number row a different 1u width than the 12-key shift row, which is
+        // exactly the misalignment the shared unit grid removes.
+        val denseRowWidth = (width - 13 * gap) / 14f
+        val sparseRowWidth = (width - 11 * gap) / 12f
+        assertEquals(99.857f, denseRowWidth, 0.01f)
+        assertEquals(117.167f, sparseRowWidth, 0.01f)
+        assertTrue(oneUnit < denseRowWidth)
+    }
+
+    @Test
+    fun oneUnitKeysKeepTheSamePitchAcrossTheGrid() {
+        val first = KeyboardGridMetrics.slotStartX(0f, width, gap)
+        val second = KeyboardGridMetrics.slotStartX(1f, width, gap)
+        val eighth = KeyboardGridMetrics.slotStartX(7f, width, gap)
+
+        assertEquals(2f, first, 0.001f)
+        assertEquals(102f, second, 0.001f)
+        assertEquals(702f, eighth, 0.001f)
+        assertEquals(100f, second - first, 0.001f)
+        assertEquals(600f, eighth - second, 0.001f)
+    }
+
+    @Test
+    fun aWideKeyStartsAfterItsOwnSlotAndKeepsHalfAGapOnBothSides() {
+        val tab = KeyboardGridMetrics.slotWidth(1.5f, width, gap)
+
+        assertEquals(146f, tab, 0.001f)
+        assertEquals(2f, KeyboardGridMetrics.slotStartX(0f, width, gap), 0.001f)
+        // last key of the row ends half a gap before the right edge
+        val lastStart = KeyboardGridMetrics.slotStartX(13.5f, width, gap)
+        val lastWidth = KeyboardGridMetrics.slotWidth(1f, width, gap)
+        assertEquals(width - gap / 2f, lastStart + lastWidth, 0.001f)
+    }
+
+    @Test
+    fun aSlotNeverHasANegativeWidth() {
+        assertEquals(0f, KeyboardGridMetrics.slotWidth(0.1f, 10f, 100f), 0.001f)
+    }
+
+    @Test
+    fun stackedCellSplitsIntoTwoTouchBandsThatMeetInTheMiddle() {
+        assertEquals(50f, StackedKeyCellGeometry.touchHeight(100f), 0.001f)
+
+        val inset = StackedKeyCellGeometry.capInset(cellHeight = 100f, gap = 4f)
+        val capHeight = StackedKeyCellGeometry.capHeight(cellHeight = 100f, gap = 4f)
+
+        assertEquals(2f, inset, 0.001f)
+        assertEquals(48f, capHeight, 0.001f)
+
+        // Top cap ends at 48, bottom cap starts at 52: the 4dp row gap is drawn.
+        val topCapBottom = capHeight
+        val bottomCapTop = 100f - capHeight
+        assertEquals(4f, bottomCapTop - topCapBottom, 0.001f)
+
+        // The touch bands still cover the whole cell with no dead strip.
+        assertEquals(100f, StackedKeyCellGeometry.touchHeight(100f) * 2f, 0.001f)
+    }
+
+    @Test
+    fun anInsetNeverEatsMoreThanHalfTheCell() {
+        assertEquals(10f, StackedKeyCellGeometry.capInset(cellHeight = 20f, gap = 40f), 0.001f)
+        assertEquals(0f, StackedKeyCellGeometry.capHeight(cellHeight = 20f, gap = 40f), 0.001f)
+    }
+}
