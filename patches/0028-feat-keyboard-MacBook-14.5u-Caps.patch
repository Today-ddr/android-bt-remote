@@ -0,0 +1,47 @@
+package com.atharok.btremote.domain.entities.remoteInput.keyboard.mac
+
+/**
+ * Horizontal grid shared by every MacBook row.
+ *
+ * The grid is 14.5 key units wide: Escape is 1.5u and the twelve function keys
+ * split the remaining 13u, while the rows below use Apple's 1u letters with
+ * 1.5u Tab/Backspace and 1.75u Caps/Return.
+ *
+ * The gap belongs to each key's own slot instead of being spaced between keys.
+ * Rows with different key counts therefore keep the same unit pitch, which is
+ * what keeps a 1u key in the same column as the row above it.
+ */
+object KeyboardGridMetrics {
+
+    const val TOTAL_UNITS: Float = 14.5f
+
+    fun unitWidth(width: Float): Float = if (width <= 0f) 0f else width / TOTAL_UNITS
+
+    /** Left edge of a slot, with half the row gap added on each side. */
+    fun slotStartX(startUnits: Float, width: Float, gap: Float): Float =
+        startUnits * unitWidth(width) + gap / 2f
+
+    fun slotWidth(widthUnits: Float, width: Float, gap: Float): Float =
+        (widthUnits * unitWidth(width) - gap).coerceAtLeast(0f)
+}
+
+/**
+ * Vertical geometry of one stacked grid cell, such as the bottom row's Up/Down
+ * pair.
+ *
+ * The cell is split into two equal touch bands that meet exactly at the middle,
+ * so a finger anywhere in the cell lands on one of the two arrows and no dead
+ * strip sits between them. The visible caps keep the row gap by pulling each one
+ * back from that shared edge by half the gap: the gap is drawn, but it is not
+ * untouchable.
+ */
+object StackedKeyCellGeometry {
+
+    fun touchHeight(cellHeight: Float): Float = (cellHeight / 2f).coerceAtLeast(0f)
+
+    fun capInset(cellHeight: Float, gap: Float): Float =
+        (gap / 2f).coerceAtLeast(0f).coerceAtMost(touchHeight(cellHeight))
+
+    fun capHeight(cellHeight: Float, gap: Float): Float =
+        (touchHeight(cellHeight) - capInset(cellHeight, gap)).coerceAtLeast(0f)
+}
