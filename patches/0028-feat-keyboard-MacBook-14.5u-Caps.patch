+package com.atharok.btremote.domain.entities.remoteInput.keyboard
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class KeyboardLedStateTest {
+
+    @Test
+    fun parsesTheThreeLockBitsTheHostReports() {
+        val numLock = KeyboardLedState.fromLedByte(0x01)
+        val capsLock = KeyboardLedState.fromLedByte(0x02)
+        val scrollLock = KeyboardLedState.fromLedByte(0x04)
+
+        assertTrue(numLock.numLock)
+        assertFalse(numLock.capsLock)
+
+        assertTrue(capsLock.capsLock)
+        assertFalse(capsLock.numLock)
+
+        assertTrue(scrollLock.scrollLock)
+    }
+
+    @Test
+    fun parsesTheExtraDescriptorBitsAndIgnoresPadding() {
+        val all = KeyboardLedState.fromLedByte(0x1F)
+        assertTrue(all.numLock)
+        assertTrue(all.capsLock)
+        assertTrue(all.scrollLock)
+        assertTrue(all.compose)
+        assertTrue(all.kana)
+
+        val paddingOnly = KeyboardLedState.fromLedByte(0xE0.toByte())
+        assertEquals(KeyboardLedState.EMPTY, paddingOnly)
+    }
+
+    @Test
+    fun writesTheSameBitsBackAsTheReportByte() {
+        val state = KeyboardLedState(numLock = true, capsLock = true, scrollLock = true)
+
+        assertEquals(0x07, state.byte.toInt())
+        assertEquals(state, KeyboardLedState.fromLedByte(state.byte))
+    }
+
+    @Test
+    fun emptyIsAllOff() {
+        assertEquals(0, KeyboardLedState.EMPTY.byte.toInt())
+        assertEquals(KeyboardLedState(), KeyboardLedState.EMPTY)
+    }
+
+    @Test
+    fun parsesAOneByteOutputReport() {
+        assertEquals(0x02, KeyboardLedState.fromOutputReport(byteArrayOf(0x02)).byte.toInt())
+        // 0x02 also reads as Caps when the host prefixes the report ID.
+        assertEquals(0x01, KeyboardLedState.fromOutputReport(byteArrayOf(0x01, 0x01)).byte.toInt())
+    }
+
+    @Test
+    fun parsesAnOutputReportThatCarriesTheReportIdFirst() {
+        // Report ID 3 followed by NumLock | CapsLock.
+        val state = KeyboardLedState.fromOutputReport(byteArrayOf(0x03, 0x03))
+
+        assertTrue(state.numLock)
+        assertTrue(state.capsLock)
+    }
+
+    @Test
+    fun anEmptyOutputReportLeavesEveryLedOff() {
+        assertEquals(KeyboardLedState.EMPTY, KeyboardLedState.fromOutputReport(ByteArray(0)))
+    }
+}
