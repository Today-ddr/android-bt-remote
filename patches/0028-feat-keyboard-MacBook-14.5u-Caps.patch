@@ -0,0 +1,68 @@
+package com.atharok.btremote.domain.entities.remoteInput.keyboard
+
+/**
+ * The LED state the host reports back through the keyboard LED output report.
+ *
+ * Only the first five bits are defined by the report descriptor; the rest of
+ * the byte is padding. Caps Lock is the bit the keyboard page draws, and it is
+ * read here instead of being latched locally.
+ *
+ * Platform limit: a host that never writes the LED output report leaves this
+ * state off, and the Caps dot then does not follow the host. Typing is never
+ * affected, because no Shift is ever synthesised for Caps Lock; only the visual
+ * state can lag behind the host.
+ */
+data class KeyboardLedState(
+    val numLock: Boolean = false,
+    val capsLock: Boolean = false,
+    val scrollLock: Boolean = false,
+    val compose: Boolean = false,
+    val kana: Boolean = false
+) {
+
+    /** The one-byte LED output report body. */
+    val byte: Byte
+        get() {
+            var value = 0
+            if (numLock) value = value or NUM_LOCK_BIT
+            if (capsLock) value = value or CAPS_LOCK_BIT
+            if (scrollLock) value = value or SCROLL_LOCK_BIT
+            if (compose) value = value or COMPOSE_BIT
+            if (kana) value = value or KANA_BIT
+            return value.toByte()
+        }
+
+    companion object {
+        val EMPTY = KeyboardLedState()
+
+        private const val NUM_LOCK_BIT = 0x01
+        private const val CAPS_LOCK_BIT = 0x02
+        private const val SCROLL_LOCK_BIT = 0x04
+        private const val COMPOSE_BIT = 0x08
+        private const val KANA_BIT = 0x10
+
+        fun fromLedByte(byte: Byte): KeyboardLedState {
+            val value = byte.toInt() and 0x1F
+            return KeyboardLedState(
+                numLock = value and NUM_LOCK_BIT != 0,
+                capsLock = value and CAPS_LOCK_BIT != 0,
+                scrollLock = value and SCROLL_LOCK_BIT != 0,
+                compose = value and COMPOSE_BIT != 0,
+                kana = value and KANA_BIT != 0
+            )
+        }
+
+        /**
+         * Parses the payload of an LED output report.
+         *
+         * A numbered report is one byte, but some host stacks prepend the report
+         * ID and hand over two. The descriptor gives this report a single data
+         * byte, so anything longer carries the ID first and the state second.
+         */
+        fun fromOutputReport(data: ByteArray): KeyboardLedState = when (data.size) {
+            0 -> EMPTY
+            1 -> fromLedByte(data[0])
+            else -> fromLedByte(data[1])
+        }
+    }
+}
