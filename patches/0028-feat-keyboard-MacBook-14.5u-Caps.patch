+package com.atharok.btremote.common.utils
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class HidReportDescriptorTest {
+
+    private fun ByteArray.indexOfSequence(vararg bytes: Int): Int {
+        val target = bytes.map { it.toByte() }
+        return indices.firstOrNull { start ->
+            start + target.size <= size &&
+                target.indices.all { this[start + it] == target[it] }
+        } ?: -1
+    }
+
+    @Test
+    fun reportIdsMatchTheIosFinalProfile() {
+        assertEquals(1, MOUSE_REPORT_ID)
+        assertEquals(2, KEYBOARD_REPORT_ID)
+        assertEquals(3, KEYBOARD_LED_REPORT_ID)
+    }
+
+    @Test
+    fun descriptorDeclaresMouseKeyboardAndLedReportsOnly() {
+        val ids = listOf(MOUSE_REPORT_ID, KEYBOARD_REPORT_ID, KEYBOARD_LED_REPORT_ID)
+
+        assertEquals(113, bluetoothHidDescriptor.size)
+        ids.forEach { id ->
+            assertTrue("report ID $id", bluetoothHidDescriptor.indexOfSequence(0x85, id) >= 0)
+        }
+    }
+
+    @Test
+    fun descriptorNoLongerCarriesAConsumerCollection() {
+        // Usage Page (Consumer Devices) followed by Usage (Consumer Control).
+        assertEquals(-1, bluetoothHidDescriptor.indexOfSequence(0x05, 0x0C))
+        assertEquals(-1, bluetoothHidDescriptor.indexOfSequence(0x05, 0x0C, 0x09, 0x01))
+    }
+
+    @Test
+    fun keyboardCollectionAdvertisesTheLedOutputReport() {
+        assertTrue(bluetoothHidDescriptor.indexOfSequence(0x05, 0x08) >= 0)
+        assertTrue(bluetoothHidDescriptor.indexOfSequence(0x91, 0x02) >= 0)
+        assertTrue(bluetoothHidDescriptor.indexOfSequence(0x95, 0x05) >= 0)
+    }
+
+    @Test
+    fun descriptorKeepsKeyboardBeforeMouse() {
+        val keyboard = bluetoothHidDescriptor.indexOfSequence(0x85, KEYBOARD_REPORT_ID)
+        val led = bluetoothHidDescriptor.indexOfSequence(0x85, KEYBOARD_LED_REPORT_ID)
+        val mouse = bluetoothHidDescriptor.indexOfSequence(0x85, MOUSE_REPORT_ID)
+
+        assertTrue(keyboard in 0 until led)
+        assertTrue(led in 0 until mouse)
+        assertFalse(mouse < 0)
+    }
+}
