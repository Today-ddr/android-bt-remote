将大写键标签对齐其他键帽的三分之一高度与自适应字号
保留宿主 LED 状态圆点和左对齐布局
---
 .../btremote/ui/views/keyboard/AdvancedKeyboard.kt       | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/app/src/main/java/com/atharok/btremote/ui/views/keyboard/AdvancedKeyboard.kt b/app/src/main/java/com/atharok/btremote/ui/views/keyboard/AdvancedKeyboard.kt
index e7163c4..b2fa068 100644
--- a/app/src/main/java/com/atharok/btremote/ui/views/keyboard/AdvancedKeyboard.kt
+++ b/app/src/main/java/com/atharok/btremote/ui/views/keyboard/AdvancedKeyboard.kt
@@ -10,6 +10,7 @@ import androidx.compose.foundation.layout.BoxWithConstraints
 import androidx.compose.foundation.layout.Column
 import androidx.compose.foundation.layout.PaddingValues
 import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxHeight
 import androidx.compose.foundation.layout.fillMaxSize
 import androidx.compose.foundation.layout.fillMaxWidth
 import androidx.compose.foundation.layout.height
@@ -40,6 +41,7 @@ import androidx.compose.ui.platform.LocalHapticFeedback
 import androidx.compose.ui.platform.LocalLayoutDirection
 import androidx.compose.ui.res.dimensionResource
 import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.text.style.TextAlign
 import androidx.compose.ui.unit.Constraints
 import androidx.compose.ui.unit.Dp
 import androidx.compose.ui.unit.LayoutDirection
@@ -409,8 +411,11 @@ private fun CapsLockKeyCell(
             )
             AdaptiveText(
                 text = stringResource(id = R.string.mac_caps),
-                percent = 0.55f,
-                modifier = Modifier.fillMaxWidth()
+                percent = 0.8f,
+                modifier = Modifier
+                    .weight(1f)
+                    .fillMaxHeight(1f / 3f),
+                textAlign = TextAlign.Start
             )
         }
     }
