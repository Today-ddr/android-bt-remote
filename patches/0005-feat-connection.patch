--- /dev/null
+++ b/app/src/test/java/com/atharok/btremote/domain/entities/settings/ConnectionSettingsTest.kt
@@ -0,0 +1,65 @@
+package com.atharok.btremote.domain.entities.settings
+
+import com.atharok.btremote.common.utils.DEFAULT_DISCONNECT_ON_BACKGROUND
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ConnectionSettingsTest {
+
+    @Test
+    fun defaultsKeepDisconnectOnBackgroundEnabled() {
+        val settings = ConnectionSettings()
+
+        assertEquals("", settings.autoConnectDeviceAddress)
+        assertFalse(settings.autoConnectPaused)
+        assertTrue(DEFAULT_DISCONNECT_ON_BACKGROUND)
+        assertTrue(settings.disconnectOnBackground)
+    }
+
+    @Test
+    fun missingPreferencesUseSafeDefaults() {
+        assertEquals(
+            ConnectionSettings(),
+            connectionSettingsFrom(
+                autoConnectDeviceAddress = null,
+                autoConnectPaused = null,
+                disconnectOnBackground = null
+            )
+        )
+    }
+
+    @Test
+    fun pausedAutoConnectProducesNoImplicitAddress() {
+        val settings = ConnectionSettings(
+            autoConnectDeviceAddress = "AA:BB:CC:DD:EE:FF",
+            autoConnectPaused = true
+        )
+
+        assertEquals("", settings.autoConnectAddressForStart())
+    }
+
+    @Test
+    fun explicitManualAddressOverridesPause() {
+        val settings = ConnectionSettings(
+            autoConnectDeviceAddress = "",
+            autoConnectPaused = true
+        )
+
+        assertEquals(
+            "11:22:33:44:55:66",
+            settings.autoConnectAddressForStart("11:22:33:44:55:66")
+        )
+    }
+
+    @Test
+    fun unpausedAutoConnectUsesSavedAddress() {
+        val settings = ConnectionSettings(
+            autoConnectDeviceAddress = "AA:BB:CC:DD:EE:FF",
+            autoConnectPaused = false
+        )
+
+        assertEquals("AA:BB:CC:DD:EE:FF", settings.autoConnectAddressForStart())
+    }
+}
