+package com.atharok.btremote.domain.entities.settings
+
+import com.atharok.btremote.common.utils.DEFAULT_DISCONNECT_ON_BACKGROUND
+
+data class ConnectionSettings(
+    val autoConnectDeviceAddress: String = "",
+    val autoConnectPaused: Boolean = false,
+    val disconnectOnBackground: Boolean = DEFAULT_DISCONNECT_ON_BACKGROUND
+) {
+    fun autoConnectAddressForStart(explicitAddress: String? = null): String =
+        explicitAddress ?: if (autoConnectPaused) "" else autoConnectDeviceAddress
+}
+
+internal fun connectionSettingsFrom(
+    autoConnectDeviceAddress: String?,
+    autoConnectPaused: Boolean?,
+    disconnectOnBackground: Boolean?
+): ConnectionSettings =
+    ConnectionSettings(
+        autoConnectDeviceAddress = autoConnectDeviceAddress ?: "",
+        autoConnectPaused = autoConnectPaused ?: false,
+        disconnectOnBackground = disconnectOnBackground ?: DEFAULT_DISCONNECT_ON_BACKGROUND
+    )
