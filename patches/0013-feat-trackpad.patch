@@ -0,0 +1,66 @@
+package com.atharok.btremote.domain.entities.settings
+
+import com.atharok.btremote.domain.entities.remoteInput.trackpad.TrackpadGestureAction
+
+data class TrackpadSettings(
+    val doubleTapDragEnabled: Boolean = true,
+    val pinchAction: TrackpadGestureAction = TrackpadGestureAction.ZOOM,
+    val rotationAction: TrackpadGestureAction = TrackpadGestureAction.NONE,
+    val threeFingerSwipeUp: TrackpadGestureAction = TrackpadGestureAction.APP_SWITCHER,
+    val threeFingerSwipeDown: TrackpadGestureAction = TrackpadGestureAction.HOME,
+    val threeFingerSwipeLeft: TrackpadGestureAction = TrackpadGestureAction.PREVIOUS_APP,
+    val threeFingerSwipeRight: TrackpadGestureAction = TrackpadGestureAction.NEXT_APP,
+    val threeFingerTap: TrackpadGestureAction = TrackpadGestureAction.SPOTLIGHT,
+    val fourFingerSwipeUp: TrackpadGestureAction = TrackpadGestureAction.MISSION_CONTROL,
+    val fourFingerSwipeDown: TrackpadGestureAction = TrackpadGestureAction.APP_EXPOSE,
+    val fourFingerSwipeLeft: TrackpadGestureAction = TrackpadGestureAction.SWITCH_SPACE_LEFT,
+    val fourFingerSwipeRight: TrackpadGestureAction = TrackpadGestureAction.SWITCH_SPACE_RIGHT,
+    val fourFingerTap: TrackpadGestureAction = TrackpadGestureAction.CONTROL_CENTER
+) {
+
+    companion object {
+
+        fun fromPreferences(
+            doubleTapDragEnabled: Boolean?,
+            pinchAction: String?,
+            rotationAction: String?,
+            threeFingerSwipeUp: String?,
+            threeFingerSwipeDown: String?,
+            threeFingerSwipeLeft: String?,
+            threeFingerSwipeRight: String?,
+            threeFingerTap: String?,
+            fourFingerSwipeUp: String?,
+            fourFingerSwipeDown: String?,
+            fourFingerSwipeLeft: String?,
+            fourFingerSwipeRight: String?,
+            fourFingerTap: String?
+        ): TrackpadSettings {
+            val defaults = TrackpadSettings()
+            return TrackpadSettings(
+                doubleTapDragEnabled = doubleTapDragEnabled ?: defaults.doubleTapDragEnabled,
+                pinchAction = actionFrom(pinchAction, defaults.pinchAction),
+                rotationAction = actionFrom(rotationAction, defaults.rotationAction),
+                threeFingerSwipeUp = actionFrom(threeFingerSwipeUp, defaults.threeFingerSwipeUp),
+                threeFingerSwipeDown = actionFrom(threeFingerSwipeDown, defaults.threeFingerSwipeDown),
+                threeFingerSwipeLeft = actionFrom(threeFingerSwipeLeft, defaults.threeFingerSwipeLeft),
+                threeFingerSwipeRight = actionFrom(threeFingerSwipeRight, defaults.threeFingerSwipeRight),
+                threeFingerTap = actionFrom(threeFingerTap, defaults.threeFingerTap),
+                fourFingerSwipeUp = actionFrom(fourFingerSwipeUp, defaults.fourFingerSwipeUp),
+                fourFingerSwipeDown = actionFrom(fourFingerSwipeDown, defaults.fourFingerSwipeDown),
+                fourFingerSwipeLeft = actionFrom(fourFingerSwipeLeft, defaults.fourFingerSwipeLeft),
+                fourFingerSwipeRight = actionFrom(fourFingerSwipeRight, defaults.fourFingerSwipeRight),
+                fourFingerTap = actionFrom(fourFingerTap, defaults.fourFingerTap)
+            )
+        }
+
+        private fun actionFrom(
+            persistedValue: String?,
+            default: TrackpadGestureAction
+        ): TrackpadGestureAction {
+            if (persistedValue == null) return default
+            return TrackpadGestureAction.entries.firstOrNull {
+                it.persistedValue == persistedValue
+            } ?: TrackpadGestureAction.NONE
+        }
+    }
+}
