+package com.atharok.btremote.domain.entities.settings
+
+import com.atharok.btremote.domain.entities.remoteInput.trackpad.TrackpadGestureAction
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TrackpadSettingsTest {
+
+    @Test
+    fun defaultsMatchTheIosGestureBindings() {
+        val settings = TrackpadSettings()
+
+        assertTrue(settings.doubleTapDragEnabled)
+        assertEquals(TrackpadGestureAction.ZOOM, settings.pinchAction)
+        assertEquals(TrackpadGestureAction.NONE, settings.rotationAction)
+        assertEquals(TrackpadGestureAction.APP_SWITCHER, settings.threeFingerSwipeUp)
+        assertEquals(TrackpadGestureAction.HOME, settings.threeFingerSwipeDown)
+        assertEquals(TrackpadGestureAction.PREVIOUS_APP, settings.threeFingerSwipeLeft)
+        assertEquals(TrackpadGestureAction.NEXT_APP, settings.threeFingerSwipeRight)
+        assertEquals(TrackpadGestureAction.SPOTLIGHT, settings.threeFingerTap)
+        assertEquals(TrackpadGestureAction.MISSION_CONTROL, settings.fourFingerSwipeUp)
+        assertEquals(TrackpadGestureAction.APP_EXPOSE, settings.fourFingerSwipeDown)
+        assertEquals(TrackpadGestureAction.SWITCH_SPACE_LEFT, settings.fourFingerSwipeLeft)
+        assertEquals(TrackpadGestureAction.SWITCH_SPACE_RIGHT, settings.fourFingerSwipeRight)
+        assertEquals(TrackpadGestureAction.CONTROL_CENTER, settings.fourFingerTap)
+    }
+
+    @Test
+    fun missingPreferencesUseDefaults() {
+        assertEquals(
+            TrackpadSettings(),
+            TrackpadSettings.fromPreferences(
+                doubleTapDragEnabled = null,
+                pinchAction = null,
+                rotationAction = null,
+                threeFingerSwipeUp = null,
+                threeFingerSwipeDown = null,
+                threeFingerSwipeLeft = null,
+                threeFingerSwipeRight = null,
+                threeFingerTap = null,
+                fourFingerSwipeUp = null,
+                fourFingerSwipeDown = null,
+                fourFingerSwipeLeft = null,
+                fourFingerSwipeRight = null,
+                fourFingerTap = null
+            )
+        )
+    }
+
+    @Test
+    fun knownStoredValuesOverrideDefaults() {
+        val settings = TrackpadSettings.fromPreferences(
+            doubleTapDragEnabled = false,
+            pinchAction = TrackpadGestureAction.NONE.persistedValue,
+            rotationAction = TrackpadGestureAction.ROTATE_LEFT.persistedValue,
+            threeFingerSwipeUp = TrackpadGestureAction.DOCK.persistedValue,
+            threeFingerSwipeDown = TrackpadGestureAction.SPOTLIGHT.persistedValue,
+            threeFingerSwipeLeft = TrackpadGestureAction.SCREENSHOT.persistedValue,
+            threeFingerSwipeRight = TrackpadGestureAction.MIDDLE_CLICK.persistedValue,
+            threeFingerTap = TrackpadGestureAction.HOME.persistedValue,
+            fourFingerSwipeUp = TrackpadGestureAction.APP_SWITCHER.persistedValue,
+            fourFingerSwipeDown = TrackpadGestureAction.NEXT_APP.persistedValue,
+            fourFingerSwipeLeft = TrackpadGestureAction.PREVIOUS_APP.persistedValue,
+            fourFingerSwipeRight = TrackpadGestureAction.NOTIFICATION_CENTER.persistedValue,
+            fourFingerTap = TrackpadGestureAction.ROTATE_RIGHT.persistedValue
+        )
+
+        assertEquals(false, settings.doubleTapDragEnabled)
+        assertEquals(TrackpadGestureAction.NONE, settings.pinchAction)
+        assertEquals(TrackpadGestureAction.ROTATE_LEFT, settings.rotationAction)
+        assertEquals(TrackpadGestureAction.DOCK, settings.threeFingerSwipeUp)
+        assertEquals(TrackpadGestureAction.SPOTLIGHT, settings.threeFingerSwipeDown)
+        assertEquals(TrackpadGestureAction.SCREENSHOT, settings.threeFingerSwipeLeft)
+        assertEquals(TrackpadGestureAction.MIDDLE_CLICK, settings.threeFingerSwipeRight)
+        assertEquals(TrackpadGestureAction.HOME, settings.threeFingerTap)
+        assertEquals(TrackpadGestureAction.APP_SWITCHER, settings.fourFingerSwipeUp)
+        assertEquals(TrackpadGestureAction.NEXT_APP, settings.fourFingerSwipeDown)
+        assertEquals(TrackpadGestureAction.PREVIOUS_APP, settings.fourFingerSwipeLeft)
+        assertEquals(TrackpadGestureAction.NOTIFICATION_CENTER, settings.fourFingerSwipeRight)
+        assertEquals(TrackpadGestureAction.ROTATE_RIGHT, settings.fourFingerTap)
+    }
+
+    @Test
+    fun unknownStoredEnumsFallBackToNoAction() {
+        val settings = TrackpadSettings.fromPreferences(
+            doubleTapDragEnabled = null,
+            pinchAction = "future_pinch",
+            rotationAction = "future_rotation",
+            threeFingerSwipeUp = "future_three_up",
+            threeFingerSwipeDown = "future_three_down",
+            threeFingerSwipeLeft = "future_three_left",
+            threeFingerSwipeRight = "future_three_right",
+            threeFingerTap = "future_three_tap",
+            fourFingerSwipeUp = "future_four_up",
+            fourFingerSwipeDown = "future_four_down",
+            fourFingerSwipeLeft = "future_four_left",
+            fourFingerSwipeRight = "future_four_right",
+            fourFingerTap = "future_four_tap"
+        )
+
+        assertEquals(TrackpadGestureAction.NONE, settings.pinchAction)
+        assertEquals(TrackpadGestureAction.NONE, settings.rotationAction)
+        assertEquals(TrackpadGestureAction.NONE, settings.threeFingerSwipeUp)
+        assertEquals(TrackpadGestureAction.NONE, settings.threeFingerSwipeDown)
+        assertEquals(TrackpadGestureAction.NONE, settings.threeFingerSwipeLeft)
+        assertEquals(TrackpadGestureAction.NONE, settings.threeFingerSwipeRight)
+        assertEquals(TrackpadGestureAction.NONE, settings.threeFingerTap)
+        assertEquals(TrackpadGestureAction.NONE, settings.fourFingerSwipeUp)
+        assertEquals(TrackpadGestureAction.NONE, settings.fourFingerSwipeDown)
+        assertEquals(TrackpadGestureAction.NONE, settings.fourFingerSwipeLeft)
+        assertEquals(TrackpadGestureAction.NONE, settings.fourFingerSwipeRight)
+        assertEquals(TrackpadGestureAction.NONE, settings.fourFingerTap)
+    }
+}
