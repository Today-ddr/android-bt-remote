diff --git a/app/src/main/java/com/atharok/btremote/data/bluetooth/BluetoothHidCore.kt b/app/src/main/java/com/atharok/btremote/data/bluetooth/BluetoothHidCore.kt
index 5965728..2f593b9 100644
--- a/app/src/main/java/com/atharok/btremote/data/bluetooth/BluetoothHidCore.kt
+++ b/app/src/main/java/com/atharok/btremote/data/bluetooth/BluetoothHidCore.kt
@@ -34,7 +34,10 @@ class BluetoothHidCore(
     private val _isBluetoothHidProfileRegistered: MutableStateFlow<Boolean> = MutableStateFlow(false)
     val isBluetoothHidProfileRegistered: StateFlow<Boolean> = _isBluetoothHidProfileRegistered
 
+    @Volatile
     private var autoConnectDeviceAddress: String = ""
+    @Volatile
+    private var isProfileProxyRequestInFlight: Boolean = false
 
     @Volatile
     private var isAppForeground: Boolean = true
@@ -54,12 +57,22 @@ class BluetoothHidCore(
                 isAppForeground &&
                 isMacAddress(autoConnectDeviceAddress)
             ) {
-                connectDevice(existingHidDevice, autoConnectDeviceAddress)
+                if (checkBluetoothConnectPermission(context)) {
+                    connectDevice(existingHidDevice, autoConnectDeviceAddress)
+                }
             }
             return
         }
 
-        adapter?.getProfileProxy(context, serviceListener, BluetoothProfile.HID_DEVICE)
+        if (isProfileProxyRequestInFlight) {
+            return
+        }
+
+        val bluetoothAdapter = adapter ?: return
+        isProfileProxyRequestInFlight = true
+        if (!bluetoothAdapter.getProfileProxy(context, serviceListener, BluetoothProfile.HID_DEVICE)) {
+            isProfileProxyRequestInFlight = false
+        }
     }
 
     fun stopBluetoothHidProfile() {
@@ -72,7 +85,9 @@ class BluetoothHidCore(
         }
         bluetoothHidDevice = null
         autoConnectDeviceAddress = ""
+        isProfileProxyRequestInFlight = false
         _deviceHidConnectionState.value = DeviceHidConnectionState()
+        _isBluetoothHidProfileRegistered.value = false
         _isBluetoothServiceRunning.value = false
     }
 
@@ -80,18 +95,27 @@ class BluetoothHidCore(
 
     private val serviceListener = object : ServiceListener {
         override fun onServiceConnected(i: Int, bluetoothProfile: BluetoothProfile?) {
+            isProfileProxyRequestInFlight = false
             if(i == BluetoothProfile.HID_DEVICE) {
-                bluetoothHidDevice = bluetoothProfile as? BluetoothHidDevice?
-                bluetoothHidDevice?.let { hidDevice ->
+                val hidDevice = bluetoothProfile as? BluetoothHidDevice
+                bluetoothHidDevice = hidDevice
+                _isBluetoothServiceRunning.value = true
+                hidDevice?.let {
                     if (checkBluetoothConnectPermission(context)) {
-                        _isBluetoothHidProfileRegistered.value = hidDevice.registerApp(hidSettings, null, null, Runnable::run, callback)
+                        _isBluetoothHidProfileRegistered.value = it.registerApp(hidSettings, null, null, Runnable::run, callback)
                     }
                 }
             }
-            _isBluetoothServiceRunning.value = true
         }
 
-        override fun onServiceDisconnected(i: Int) {}
+        override fun onServiceDisconnected(i: Int) {
+            if(i == BluetoothProfile.HID_DEVICE) {
+                isProfileProxyRequestInFlight = false
+                bluetoothHidDevice = null
+                _isBluetoothHidProfileRegistered.value = false
+                _isBluetoothServiceRunning.value = false
+            }
+        }
     }
 
     // ---- BluetoothHidDevice.Callback implementation ----
