@@ -89,11 +90,15 @@ class BluetoothHidService : Service() {
     override fun onBind(intent: Intent?): IBinder = Binder()
 
     override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        val explicitConnectAddress = intent?.getStringExtra(EXTRA_CONNECT_ADDRESS)
+        if (explicitConnectAddress == null && hasHandledStart) {
+            return START_NOT_STICKY
+        }
+        hasHandledStart = true
+
         try {
             startForeground(NOTIFICATION_ID, createNotification())
-            startBluetoothHidProfile(
-                intent?.getStringExtra(EXTRA_CONNECT_ADDRESS)
-            )
+            startBluetoothHidProfile(explicitConnectAddress)
         } catch (exception: Exception) {
             stopSelf()
         }
