+package com.atharok.btremote.domain.entities.remoteInput.keyboard.mac
+
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.KeyboardKey
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.advancedKeyboard.AdvancedKeyBehavior
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.advancedKeyboard.TextAdvancedKeyboardKey
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class MacKeyboardLayoutTest {
+
+    private fun key(
+        byte: Byte,
+        weight: Float = 1f,
+        kind: MacKeyboardKeyKind = MacKeyboardKeyKind.ORDINARY,
+        behavior: AdvancedKeyBehavior = AdvancedKeyBehavior.KEY
+    ): MacKeyboardKey = MacKeyboardKey(
+        key = TextAdvancedKeyboardKey(
+            byte = byte,
+            weight = weight,
+            text = "L",
+            behavior = behavior
+        ),
+        kind = kind
+    )
+
+    @Test
+    fun layoutKeepsSixOrderedRows() {
+        val layout = MacKeyboardLayout(
+            rows = listOf(
+                MacKeyboardRow(listOf(key(KeyboardKey.KEY_ESCAPE.byte))),
+                MacKeyboardRow(listOf(key(KeyboardKey.ROW_1_KEY_01.byte))),
+                MacKeyboardRow(listOf(key(KeyboardKey.ROW_2_KEY_00.byte))),
+                MacKeyboardRow(listOf(key(KeyboardKey.ROW_3_KEY_00.byte))),
+                MacKeyboardRow(listOf(key(KeyboardKey.ROW_4_KEY_01.byte))),
+                MacKeyboardRow(listOf(key(KeyboardKey.KEY_SPACE_BAR.byte)))
+            )
+        )
+
+        assertEquals(6, layout.rows.size)
+        assertEquals(
+            listOf(
+                KeyboardKey.KEY_ESCAPE.byte,
+                KeyboardKey.ROW_1_KEY_01.byte,
+                KeyboardKey.ROW_2_KEY_00.byte,
+                KeyboardKey.ROW_3_KEY_00.byte,
+                KeyboardKey.ROW_4_KEY_01.byte,
+                KeyboardKey.KEY_SPACE_BAR.byte
+            ),
+            layout.keys.map { it.byte }
+        )
+    }
+
+    @Test
+    fun rowKeepsKeyOrderAndSumsExplicitWeights() {
+        val row = MacKeyboardRow(
+            listOf(
+                key(KeyboardKey.ROW_3_KEY_11.byte, 2.25f),
+                key(KeyboardKey.ROW_4_KEY_01.byte),
+                key(KeyboardKey.KEY_SHIFT_RIGHT.byte, 1.75f)
+            )
+        )
+
+        assertEquals(
+            listOf(
+                KeyboardKey.ROW_3_KEY_11.byte,
+                KeyboardKey.ROW_4_KEY_01.byte,
+                KeyboardKey.KEY_SHIFT_RIGHT.byte
+            ),
+            row.keys.map { it.byte }
+        )
+        assertEquals(5f, row.totalWeight, 0.001f)
+    }
+
+    @Test
+    fun keyExposesUsageByteWeightKindAndBehavior() {
+        val modifier = key(
+            byte = KeyboardKey.KEY_CTRL_LEFT.byte,
+            weight = 1.25f,
+            kind = MacKeyboardKeyKind.MODIFIER,
+            behavior = AdvancedKeyBehavior.MODIFIER
+        )
+
+        assertEquals(KeyboardKey.KEY_CTRL_LEFT.byte, modifier.byte)
+        assertEquals(1.25f, modifier.weight, 0.001f)
+        assertEquals(MacKeyboardKeyKind.MODIFIER, modifier.kind)
+        assertEquals(AdvancedKeyBehavior.MODIFIER, modifier.behavior)
+    }
+
+    @Test
+    fun functionRowIsEscF1ToF12PrintScreenAndDelete() {
+        val row = MacKeyboardSpec.functionRow
+
+        assertEquals(
+            listOf(
+                KeyboardKey.KEY_ESCAPE.byte,
+                KeyboardKey.KEY_F1.byte,
+                KeyboardKey.KEY_F2.byte,
+                KeyboardKey.KEY_F3.byte,
+                KeyboardKey.KEY_F4.byte,
+                KeyboardKey.KEY_F5.byte,
+                KeyboardKey.KEY_F6.byte,
+                KeyboardKey.KEY_F7.byte,
+                KeyboardKey.KEY_F8.byte,
+                KeyboardKey.KEY_F9.byte,
+                KeyboardKey.KEY_F10.byte,
+                KeyboardKey.KEY_F11.byte,
+                KeyboardKey.KEY_F12.byte,
+                KeyboardKey.KEY_PRINT_SCREEN.byte,
+                KeyboardKey.KEY_DELETE_FORWARD.byte
+            ),
+            row.keys.map { it.byte }
+        )
+        assertEquals(15, row.keys.size)
+        assertEquals(15f, row.totalWeight, 0.001f)
+        assertEquals(
+            List(15) { 1f },
+            row.keys.map { it.weight }
+        )
+    }
+
+    @Test
+    fun functionRowAndEscapeStayOrdinaryKeys() {
+        val row = MacKeyboardSpec.functionRow
+
+        assertTrue(row.keys.all { it.behavior == AdvancedKeyBehavior.KEY })
+        assertTrue(row.keys.all { it.kind == MacKeyboardKeyKind.ORDINARY })
+    }
+
+    @Test
+    fun bottomRowIsTheFixedModifierRow() {
+        val row = MacKeyboardSpec.bottomRow
+
+        assertEquals(
+            listOf(
+                KeyboardKey.KEY_CTRL_LEFT.byte,
+                KeyboardKey.KEY_ALT.byte,
+                KeyboardKey.KEY_META_LEFT.byte,
+                KeyboardKey.KEY_SPACE_BAR.byte,
+                KeyboardKey.KEY_META_RIGHT.byte,
+                KeyboardKey.KEY_ALT_GR.byte,
+                KeyboardKey.KEY_CTRL_RIGHT.byte,
+                KeyboardKey.KEY_LEFT_ARROW.byte,
+                KeyboardKey.KEY_DOWN_ARROW.byte,
+                KeyboardKey.KEY_RIGHT_ARROW.byte
+            ),
+            row.keys.map { it.byte }
+        )
+        assertEquals(
+            listOf(1.25f, 1.25f, 1.25f, 5f, 1.25f, 1.25f, 1.25f, 1f, 1f, 1.75f),
+            row.keys.map { it.weight }
+        )
+    }
+
+    @Test
+    fun bottomRowKeepsEveryLegacyModifierUsage() {
+        val row = MacKeyboardSpec.bottomRow
+        val modifierBytes = row.keys
+            .filter { it.kind == MacKeyboardKeyKind.MODIFIER }
+            .map { it.behavior }
+
+        assertTrue(modifierBytes.isNotEmpty())
+        assertTrue(modifierBytes.all { it == AdvancedKeyBehavior.MODIFIER })
+        assertEquals(
+            listOf(
+                KeyboardKey.KEY_CTRL_LEFT.byte,
+                KeyboardKey.KEY_ALT.byte,
+                KeyboardKey.KEY_META_LEFT.byte,
+                KeyboardKey.KEY_META_RIGHT.byte,
+                KeyboardKey.KEY_ALT_GR.byte,
+                KeyboardKey.KEY_CTRL_RIGHT.byte
+            ),
+            row.keys.filter { it.kind == MacKeyboardKeyKind.MODIFIER }.map { it.byte }
+        )
+        assertEquals(
+            listOf(AdvancedKeyBehavior.KEY, AdvancedKeyBehavior.KEY, AdvancedKeyBehavior.KEY, AdvancedKeyBehavior.KEY),
+            row.keys.filter { it.kind == MacKeyboardKeyKind.ORDINARY }.map { it.behavior }
+        )
+    }
+}
