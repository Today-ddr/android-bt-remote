+package com.atharok.btremote.domain.entities.remoteInput.keyboard.mac
+
+import androidx.compose.ui.text.style.TextAlign
+import com.atharok.btremote.R
+import com.atharok.btremote.domain.entities.remoteInput.RemoteButtonProperties
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.KeyboardKey
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.advancedKeyboard.AdvancedKeyBehavior
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.advancedKeyboard.AdvancedKeyboardKey
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.advancedKeyboard.CapsLockAdvancedKeyboardKey
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.advancedKeyboard.CharacterAdvancedKeyboardKey
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.advancedKeyboard.IconAdvancedKeyboardKey
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.advancedKeyboard.ResourceTextAdvancedKeyboardKey
+import com.atharok.btremote.domain.entities.remoteInput.keyboard.advancedKeyboard.TextAdvancedKeyboardKey
+
+/**
+ * Physical role of a key inside the MacBook presentation. The role is independent from the
+ * HID usage byte and from the legend so the factory can relocate a usage without touching it.
+ */
+enum class MacKeyboardKeyKind {
+    ORDINARY,
+    CAPS_LOCK,
+    MODIFIER,
+    ISO_EXTRA
+}
+
+data class MacKeyboardKey(
+    val key: AdvancedKeyboardKey,
+    val kind: MacKeyboardKeyKind
+) {
+    val byte: Byte get() = key.byte
+    val weight: Float get() = key.weight
+    val behavior: AdvancedKeyBehavior get() = key.behavior
+}
+
+data class MacKeyboardRow(val keys: List<MacKeyboardKey>) {
+    val totalWeight: Float get() = keys.sumOf { it.weight.toDouble() }.toFloat()
+}
+
+data class MacKeyboardLayout(val rows: List<MacKeyboardRow>) {
+    val keys: List<MacKeyboardKey> get() = rows.flatMap { it.keys }
+}
+
+/** Structural key widths of the MacBook presentation, expressed in key units. */
+object MacKeyboardKeyWeight {
+    const val ORDINARY = 1f
+    const val TAB = 1.5f
+    const val BACKSPACE = 2f
+    const val ROW_BACKSLASH = 1.5f
+    const val CAPS_LOCK = 1.75f
+    const val SHIFT_LEFT = 2.25f
+    const val SHIFT_RIGHT = 1.75f
+    const val ENTER = 2.25f
+    const val SPACE = 5f
+    const val BOTTOM_MODIFIER = 1.25f
+    const val ARROW_LEFT = 1f
+    const val ARROW_DOWN = 1f
+    const val ARROW_RIGHT = 1.75f
+}
+
+/**
+ * Language independent part of the MacBook layout: the function row, the bottom modifier row and
+ * the structural keys the factory interleaves with the language legends of each
+ * [com.atharok.btremote.domain.entities.remoteInput.keyboard.advancedKeyboard.AdvancedKeyboardLayout].
+ */
+object MacKeyboardSpec {
+
+    private fun textKey(byte: Byte, text: String, weight: Float = MacKeyboardKeyWeight.ORDINARY) =
+        MacKeyboardKey(
+            key = TextAdvancedKeyboardKey(byte = byte, weight = weight, text = text),
+            kind = MacKeyboardKeyKind.ORDINARY
+        )
+
+    private fun resourceKey(
+        byte: Byte,
+        textRes: Int,
+        weight: Float,
+        textAlign: TextAlign = TextAlign.Center,
+        behavior: AdvancedKeyBehavior = AdvancedKeyBehavior.KEY,
+        kind: MacKeyboardKeyKind = MacKeyboardKeyKind.ORDINARY
+    ) = MacKeyboardKey(
+        key = ResourceTextAdvancedKeyboardKey(
+            byte = byte,
+            weight = weight,
+            textRes = textRes,
+            textAlign = textAlign,
+            behavior = behavior
+        ),
+        kind = kind
+    )
+
+    private fun modifierKey(byte: Byte, textRes: Int, textAlign: TextAlign, weight: Float) =
+        resourceKey(
+            byte = byte,
+            textRes = textRes,
+            weight = weight,
+            textAlign = textAlign,
+            behavior = AdvancedKeyBehavior.MODIFIER,
+            kind = MacKeyboardKeyKind.MODIFIER
+        )
+
+    private fun iconKey(properties: RemoteButtonProperties, weight: Float) =
+        MacKeyboardKey(
+            key = IconAdvancedKeyboardKey(properties = properties, weight = weight),
+            kind = MacKeyboardKeyKind.ORDINARY
+        )
+
+    private val escape = resourceKey(KeyboardKey.KEY_ESCAPE.byte, R.string.escape, MacKeyboardKeyWeight.ORDINARY)
+
+    private val functionKeys: List<MacKeyboardKey> = listOf(
+        KeyboardKey.KEY_F1 to "F1",
+        KeyboardKey.KEY_F2 to "F2",
+        KeyboardKey.KEY_F3 to "F3",
+        KeyboardKey.KEY_F4 to "F4",
+        KeyboardKey.KEY_F5 to "F5",
+        KeyboardKey.KEY_F6 to "F6",
+        KeyboardKey.KEY_F7 to "F7",
+        KeyboardKey.KEY_F8 to "F8",
+        KeyboardKey.KEY_F9 to "F9",
+        KeyboardKey.KEY_F10 to "F10",
+        KeyboardKey.KEY_F11 to "F11",
+        KeyboardKey.KEY_F12 to "F12"
+    ).map { (key, legend) -> textKey(key.byte, legend) }
+
+    private val printScreen = iconKey(
+        properties = RemoteButtonProperties.KeyboardPrintScreenButton,
+        weight = MacKeyboardKeyWeight.ORDINARY
+    )
+
+    /** Forward delete. MacBook keyboards expose it on the function row, next to Print Screen. */
+    private val deleteForward = textKey(KeyboardKey.KEY_DELETE_FORWARD.byte, "Del")
+
+    val functionRow = MacKeyboardRow(listOf(escape) + functionKeys + listOf(printScreen, deleteForward))
+
+    val tab = iconKey(RemoteButtonProperties.KeyboardTabButton, MacKeyboardKeyWeight.TAB)
+
+    val backspace = iconKey(RemoteButtonProperties.KeyboardBackspaceButton, MacKeyboardKeyWeight.BACKSPACE)
+
+    val capsLock = MacKeyboardKey(
+        key = ResourceTextAdvancedKeyboardKey(
+            byte = KeyboardKey.KEY_CAPS_LOCK.byte,
+            weight = MacKeyboardKeyWeight.CAPS_LOCK,
+            textRes = R.string.caps_lock,
+            textAlign = TextAlign.Start,
+            behavior = AdvancedKeyBehavior.CAPS_LOCK
+        ),
+        kind = MacKeyboardKeyKind.CAPS_LOCK
+    )
+
+    val enter = iconKey(RemoteButtonProperties.KeyboardEnterButton, MacKeyboardKeyWeight.ENTER)
+
+    val shiftLeft = modifierKey(
+        byte = KeyboardKey.KEY_SHIFT_LEFT.byte,
+        textRes = R.string.shift,
+        textAlign = TextAlign.Start,
+        weight = MacKeyboardKeyWeight.SHIFT_LEFT
+    )
+
+    val shiftRight = modifierKey(
+        byte = KeyboardKey.KEY_SHIFT_RIGHT.byte,
+        textRes = R.string.shift,
+        textAlign = TextAlign.End,
+        weight = MacKeyboardKeyWeight.SHIFT_RIGHT
+    )
+
+    val upArrow = iconKey(RemoteButtonProperties.KeyboardUpButton, MacKeyboardKeyWeight.ORDINARY)
+
+    val leftArrow = iconKey(RemoteButtonProperties.KeyboardLeftButton, MacKeyboardKeyWeight.ARROW_LEFT)
+
+    val downArrow = iconKey(RemoteButtonProperties.KeyboardDownButton, MacKeyboardKeyWeight.ARROW_DOWN)
+
+    val rightArrow = iconKey(RemoteButtonProperties.KeyboardRightButton, MacKeyboardKeyWeight.ARROW_RIGHT)
+
+    val controlLeft = modifierKey(
+        byte = KeyboardKey.KEY_CTRL_LEFT.byte,
+        textRes = R.string.ctrl,
+        textAlign = TextAlign.Start,
+        weight = MacKeyboardKeyWeight.BOTTOM_MODIFIER
+    )
+
+    val optionLeft = modifierKey(
+        byte = KeyboardKey.KEY_ALT.byte,
+        textRes = R.string.alt,
+        textAlign = TextAlign.Start,
+        weight = MacKeyboardKeyWeight.BOTTOM_MODIFIER
+    )
+
+    val commandLeft = modifierKey(
+        byte = KeyboardKey.KEY_META_LEFT.byte,
+        textRes = R.string.meta,
+        textAlign = TextAlign.Start,
+        weight = MacKeyboardKeyWeight.BOTTOM_MODIFIER
+    )
+
+    val space = iconKey(RemoteButtonProperties.KeyboardSpaceBarButton, MacKeyboardKeyWeight.SPACE)
+
+    val commandRight = modifierKey(
+        byte = KeyboardKey.KEY_META_RIGHT.byte,
+        textRes = R.string.meta,
+        textAlign = TextAlign.End,
+        weight = MacKeyboardKeyWeight.BOTTOM_MODIFIER
+    )
+
+    /** Right Option. It keeps the Alt Gr usage so ISO layouts never lose that modifier. */
+    val optionRight = modifierKey(
+        byte = KeyboardKey.KEY_ALT_GR.byte,
+        textRes = R.string.alt_gr,
+        textAlign = TextAlign.End,
+        weight = MacKeyboardKeyWeight.BOTTOM_MODIFIER
+    )
+
+    /** Right Control, kept from the previous keyboard so no modifier usage disappears. */
+    val controlRight = modifierKey(
+        byte = KeyboardKey.KEY_CTRL_RIGHT.byte,
+        textRes = R.string.ctrl,
+        textAlign = TextAlign.End,
+        weight = MacKeyboardKeyWeight.BOTTOM_MODIFIER
+    )
+
+    val bottomRow = MacKeyboardRow(
+        listOf(
+            controlLeft,
+            optionLeft,
+            commandLeft,
+            space,
+            commandRight,
+            optionRight,
+            controlRight,
+            leftArrow,
+            downArrow,
+            rightArrow
+        )
+    )
+}
+
+/**
+ * Returns a copy of this key with the width required by its position in the MacBook layout, so a
+ * usage can move between rows without dragging the width of its original row along.
+ */
+fun MacKeyboardKey.withWeight(weight: Float): MacKeyboardKey = copy(key = key.withWeight(weight))
+
+internal fun AdvancedKeyboardKey.withWeight(weight: Float): AdvancedKeyboardKey = when (this) {
+    is CharacterAdvancedKeyboardKey -> copy(weight = weight)
+    is ResourceTextAdvancedKeyboardKey -> copy(weight = weight)
+    is TextAdvancedKeyboardKey -> copy(weight = weight)
+    is CapsLockAdvancedKeyboardKey -> copy(weight = weight)
+    is IconAdvancedKeyboardKey -> copy(weight = weight)
+}
