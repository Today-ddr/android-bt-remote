+/**
+ * Text key whose legend is a string resource. It resolves its label while rendering so the
+ * layout model can stay free of Android resources and be built inside unit tests.
+ */
+data class ResourceTextAdvancedKeyboardKey(
+    override val byte: Byte,
+    override val weight: Float,
+    @param:StringRes val textRes: Int,
+    val textAlign: TextAlign = TextAlign.Center,
+    override val behavior: AdvancedKeyBehavior = AdvancedKeyBehavior.KEY
+): AdvancedKeyboardKey() {
+
+    @Composable
+    override fun KeyboardKeyView(
+        touchDown: (Byte) -> Unit,
+        touchUp: (Byte) -> Unit,
+        modifier: Modifier,
+        shape: Shape,
+        elevation: Dp
+    ) {
+        TextKeyboardKey(
+            text = stringResource(textRes),
+            touchDown = { touchDown(byte) },
+            touchUp = { touchUp(byte) },
+            modifier = modifier,
+            shape = shape,
+            elevation = elevation,
+            textAlign = textAlign
+        )
+    }
+}
+
 data class CapsLockAdvancedKeyboardKey(
     override val weight: Float,
     val text: String
diff --git a/app/src/main/java/com/atharok/btremote/domain/entities/remoteInput/keyboard/mac/MacKeyboardLayout.kt b/app/src/main/java/com/atharok/btremote/domain/entities/remoteInput/keyboard/mac/MacKeyboardLayout.kt
