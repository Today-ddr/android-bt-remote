diff --git a/app/src/main/java/com/atharok/btremote/domain/connection/ConnectionPolicy.kt b/app/src/main/java/com/atharok/btremote/domain/connection/ConnectionPolicy.kt
new file mode 100644
index 0000000..1918198
--- /dev/null
+++ b/app/src/main/java/com/atharok/btremote/domain/connection/ConnectionPolicy.kt
@@ -0,0 +1,15 @@
+package com.atharok.btremote.domain.connection
+
+data class BackgroundConnectionAction(
+    val stopService: Boolean,
+    val pauseAutoConnect: Boolean
+)
+
+object ConnectionPolicy {
+
+    fun onAppBackground(disconnectOnBackground: Boolean): BackgroundConnectionAction =
+        BackgroundConnectionAction(
+            stopService = disconnectOnBackground,
+            pauseAutoConnect = disconnectOnBackground
+        )
+}
diff --git a/app/src/test/java/com/atharok/btremote/domain/connection/ConnectionPolicyTest.kt b/app/src/test/java/com/atharok/btremote/domain/connection/ConnectionPolicyTest.kt
new file mode 100644
index 0000000..a79c70b
--- /dev/null
+++ b/app/src/test/java/com/atharok/btremote/domain/connection/ConnectionPolicyTest.kt
@@ -0,0 +1,24 @@
+package com.atharok.btremote.domain.connection
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class ConnectionPolicyTest {
+
+    @Test
+    fun backgroundWithDisconnectEnabledStopsServiceAndPausesAutoConnect() {
+        assertEquals(
+            BackgroundConnectionAction(stopService = true, pauseAutoConnect = true),
+            ConnectionPolicy.onAppBackground(disconnectOnBackground = true)
+        )
+    }
+
+    @Test
+    fun backgroundWithDisconnectDisabledKeepsService() {
+        assertEquals(
+            BackgroundConnectionAction(stopService = false, pauseAutoConnect = false),
+            ConnectionPolicy.onAppBackground(disconnectOnBackground = false)
+        )
+    }
+
+}
