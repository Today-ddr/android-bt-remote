@@ -0,0 +1,40 @@
+package com.atharok.btremote.domain.haptics
+
+import com.atharok.btremote.domain.entities.settings.HapticIntensity
+import com.atharok.btremote.domain.entities.settings.HapticSettings
+
+enum class HapticSource {
+    TRACKPAD,
+    KEYBOARD
+}
+
+object HapticPolicy {
+
+    const val SCROLL_INTERVAL_MILLIS = 40L
+
+    fun shouldTap(settings: HapticSettings, source: HapticSource): Boolean {
+        if (!settings.enabled) return false
+        return when (source) {
+            HapticSource.TRACKPAD -> settings.trackpad
+            HapticSource.KEYBOARD -> settings.keyboard
+        }
+    }
+
+    fun shouldEmitScroll(
+        settings: HapticSettings,
+        lastTickMillis: Long?,
+        nowMillis: Long
+    ): Boolean {
+        if (!settings.enabled || !settings.trackpad || !settings.scroll) return false
+        return lastTickMillis == null ||
+                nowMillis - lastTickMillis >= SCROLL_INTERVAL_MILLIS
+    }
+
+    fun amplitude(settings: HapticSettings): Int {
+        return when (settings.intensity) {
+            HapticIntensity.LIGHT -> 64
+            HapticIntensity.MEDIUM -> 128
+            HapticIntensity.STRONG -> 255
+        }
+    }
+}
