+package com.atharok.btremote.domain.entities.settings
+
+enum class HapticIntensity(val persistedValue: String) {
+    LIGHT("light"),
+    MEDIUM("medium"),
+    STRONG("strong");
+
+    companion object {
+
+        fun fromPersistedValue(value: String?): HapticIntensity {
+            return entries.firstOrNull { it.persistedValue == value } ?: STRONG
+        }
+    }
+}
+
+data class HapticSettings(
+    val enabled: Boolean = true,
+    val trackpad: Boolean = true,
+    val scroll: Boolean = true,
+    val keyboard: Boolean = true,
+    val intensity: HapticIntensity = HapticIntensity.STRONG
+) {
+
+    companion object {
+
+        fun fromPreferences(
+            enabled: Boolean?,
+            trackpad: Boolean?,
+            scroll: Boolean?,
+            keyboard: Boolean?,
+            intensity: String?
+        ): HapticSettings {
+            val defaults = HapticSettings()
+            return HapticSettings(
+                enabled = enabled ?: defaults.enabled,
+                trackpad = trackpad ?: defaults.trackpad,
+                scroll = scroll ?: defaults.scroll,
+                keyboard = keyboard ?: defaults.keyboard,
+                intensity = HapticIntensity.fromPersistedValue(intensity)
+            )
+        }
+    }
+}
