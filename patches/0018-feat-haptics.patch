+package com.atharok.btremote.domain.haptics
+
+import com.atharok.btremote.domain.entities.settings.HapticIntensity
+import com.atharok.btremote.domain.entities.settings.HapticSettings
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class HapticPolicyTest {
+
+    private val allEnabled = HapticSettings()
+
+    @Test
+    fun defaultsEnableEveryGroupAtStrongIntensity() {
+        assertTrue(allEnabled.enabled)
+        assertTrue(allEnabled.trackpad)
+        assertTrue(allEnabled.scroll)
+        assertTrue(allEnabled.keyboard)
+        assertEquals(HapticIntensity.STRONG, allEnabled.intensity)
+    }
+
+    @Test
+    fun masterSwitchDisablesEveryTapSource() {
+        val disabled = allEnabled.copy(enabled = false)
+
+        assertFalse(HapticPolicy.shouldTap(disabled, HapticSource.TRACKPAD))
+        assertFalse(HapticPolicy.shouldTap(disabled, HapticSource.KEYBOARD))
+    }
+
+    @Test
+    fun trackpadAndKeyboardGroupsAreGatedIndependently() {
+        val keyboardOnly = allEnabled.copy(trackpad = false)
+        val trackpadOnly = allEnabled.copy(keyboard = false)
+
+        assertFalse(HapticPolicy.shouldTap(keyboardOnly, HapticSource.TRACKPAD))
+        assertTrue(HapticPolicy.shouldTap(keyboardOnly, HapticSource.KEYBOARD))
+        assertTrue(HapticPolicy.shouldTap(trackpadOnly, HapticSource.TRACKPAD))
+        assertFalse(HapticPolicy.shouldTap(trackpadOnly, HapticSource.KEYBOARD))
+    }
+
+    @Test
+    fun scrollRequiresMasterTrackpadAndScrollGroups() {
+        assertTrue(HapticPolicy.shouldEmitScroll(allEnabled, null, 0))
+        assertFalse(HapticPolicy.shouldEmitScroll(allEnabled.copy(enabled = false), null, 0))
+        assertFalse(HapticPolicy.shouldEmitScroll(allEnabled.copy(trackpad = false), null, 0))
+        assertFalse(HapticPolicy.shouldEmitScroll(allEnabled.copy(scroll = false), null, 0))
+    }
+
+    @Test
+    fun scrollAllowsOneTickPerFortyMilliseconds() {
+        assertFalse(HapticPolicy.shouldEmitScroll(allEnabled, 100, 139))
+        assertTrue(HapticPolicy.shouldEmitScroll(allEnabled, 100, 140))
+        assertTrue(HapticPolicy.shouldEmitScroll(allEnabled, 100, 141))
+    }
+
+    @Test
+    fun intensityUsesDistinctOrderedAmplitudes() {
+        assertEquals(64, HapticPolicy.amplitude(allEnabled.copy(intensity = HapticIntensity.LIGHT)))
+        assertEquals(128, HapticPolicy.amplitude(allEnabled.copy(intensity = HapticIntensity.MEDIUM)))
+        assertEquals(255, HapticPolicy.amplitude(allEnabled.copy(intensity = HapticIntensity.STRONG)))
+    }
+
+    @Test
+    fun missingPreferencesKeepAllGroupsEnabledAtStrongIntensity() {
+        assertEquals(
+            HapticSettings(),
+            HapticSettings.fromPreferences(
+                enabled = null,
+                trackpad = null,
+                scroll = null,
+                keyboard = null,
+                intensity = null
+            )
+        )
+    }
+
+    @Test
+    fun unknownStoredIntensityFallsBackToStrong() {
+        val settings = HapticSettings.fromPreferences(
+            enabled = null,
+            trackpad = null,
+            scroll = null,
+            keyboard = null,
+            intensity = "future_intensity"
+        )
+
+        assertEquals(HapticIntensity.STRONG, settings.intensity)
+    }
+
+    @Test
+    fun storedValuesOverrideEveryHapticDefault() {
+        val settings = HapticSettings.fromPreferences(
+            enabled = false,
+            trackpad = false,
+            scroll = false,
+            keyboard = false,
+            intensity = HapticIntensity.LIGHT.persistedValue
+        )
+
+        assertEquals(
+            HapticSettings(
+                enabled = false,
+                trackpad = false,
+                scroll = false,
+                keyboard = false,
+                intensity = HapticIntensity.LIGHT
+            ),
+            settings
+        )
+    }
+}
