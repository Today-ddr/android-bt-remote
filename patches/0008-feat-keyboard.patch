+++ b/app/src/test/java/com/atharok/btremote/domain/entities/remoteInput/keyboard/KeyboardReportStateTest.kt
@@ -0,0 +1,126 @@
+package com.atharok.btremote.domain.entities.remoteInput.keyboard
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class KeyboardReportStateTest {
+
+    @Test
+    fun pressAndReleaseLetterProducesDownAndUpReports() {
+        val state = KeyboardReportState()
+
+        assertArrayEquals(
+            byteArrayOf(0, 0, KeyboardKey.ROW_3_KEY_00.byte, 0, 0, 0, 0, 0),
+            state.pressKey(KeyboardKey.ROW_3_KEY_00.byte)
+        )
+        assertArrayEquals(
+            ByteArray(8),
+            state.releaseKey(KeyboardKey.ROW_3_KEY_00.byte)
+        )
+    }
+
+    @Test
+    fun modifierAndKeyAreReportedTogether() {
+        val state = KeyboardReportState()
+
+        state.pressModifier(KeyboardKey.KEY_CTRL_LEFT.byte)
+
+        assertArrayEquals(
+            byteArrayOf(
+                KeyboardKey.KEY_CTRL_LEFT.byte,
+                0,
+                KeyboardKey.ROW_4_KEY_03.byte,
+                0,
+                0,
+                0,
+                0,
+                0
+            ),
+            state.pressKey(KeyboardKey.ROW_4_KEY_03.byte)
+        )
+    }
+
+    @Test
+    fun capsLockAddsShiftOnlyToLetters() {
+        val state = KeyboardReportState()
+
+        state.toggleCapsLock()
+
+        assertArrayEquals(
+            byteArrayOf(
+                KeyboardKey.KEY_SHIFT_LEFT.byte,
+                0,
+                KeyboardKey.ROW_3_KEY_00.byte,
+                0,
+                0,
+                0,
+                0,
+                0
+            ),
+            state.pressKey(KeyboardKey.ROW_3_KEY_00.byte)
+        )
+        state.releaseKey(KeyboardKey.ROW_3_KEY_00.byte)
+        assertArrayEquals(
+            byteArrayOf(
+                0,
+                0,
+                KeyboardKey.ROW_1_KEY_01.byte,
+                0,
+                0,
+                0,
+                0,
+                0
+            ),
+            state.pressKey(KeyboardKey.ROW_1_KEY_01.byte)
+        )
+    }
+
+    @Test
+    fun capsLockTapSendsCapsThenZero() {
+        val state = KeyboardReportState()
+
+        val reports = state.toggleCapsLock()
+
+        assertArrayEquals(
+            byteArrayOf(
+                0,
+                0,
+                KeyboardKey.KEY_CAPS_LOCK.byte,
+                0,
+                0,
+                0,
+                0,
+                0
+            ),
+            reports[0]
+        )
+        assertArrayEquals(ByteArray(8), reports[1])
+        assertTrue(state.isCapsLockOn)
+    }
+
+    @Test
+    fun clearReleasesKeysModifiersAndCapsState() {
+        val state = KeyboardReportState()
+        state.pressModifier(KeyboardKey.KEY_SHIFT_LEFT.byte)
+        state.pressKey(KeyboardKey.ROW_3_KEY_00.byte)
+        state.toggleCapsLock()
+
+        assertArrayEquals(ByteArray(8), state.clear())
+        assertFalse(state.isCapsLockOn)
+        assertArrayEquals(
+            byteArrayOf(
+                0,
+                0,
+                KeyboardKey.ROW_3_KEY_00.byte,
+                0,
+                0,
+                0,
+                0,
+                0
+            ),
+            state.pressKey(KeyboardKey.ROW_3_KEY_00.byte)
+        )
+    }
+}
