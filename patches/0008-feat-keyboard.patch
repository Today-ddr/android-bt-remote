+++ b/app/src/main/java/com/atharok/btremote/domain/entities/remoteInput/keyboard/KeyboardReportState.kt
@@ -0,0 +1,74 @@
+package com.atharok.btremote.domain.entities.remoteInput.keyboard
+
+class KeyboardReportState {
+
+    private val pressedKeys = linkedSetOf<Byte>()
+    private var modifierMask: Int = 0
+
+    var isCapsLockOn: Boolean = false
+        private set
+
+    fun pressModifier(modifier: Byte): ByteArray {
+        modifierMask = modifierMask or modifier.toInt()
+        return report()
+    }
+
+    fun releaseModifier(modifier: Byte): ByteArray {
+        modifierMask = modifierMask and modifier.toInt().inv()
+        return report()
+    }
+
+    fun pressKey(key: Byte): ByteArray {
+        if (pressedKeys.size < MAX_KEYS) {
+            pressedKeys.add(key)
+        }
+        return report()
+    }
+
+    fun releaseKey(key: Byte): ByteArray {
+        pressedKeys.remove(key)
+        return report()
+    }
+
+    fun toggleCapsLock(): List<ByteArray> {
+        isCapsLockOn = !isCapsLockOn
+        return listOf(
+            report(extraKeys = listOf(KeyboardKey.KEY_CAPS_LOCK.byte)),
+            ByteArray(REPORT_SIZE)
+        )
+    }
+
+    fun clear(): ByteArray {
+        pressedKeys.clear()
+        modifierMask = 0
+        isCapsLockOn = false
+        return ByteArray(REPORT_SIZE)
+    }
+
+    private fun report(extraKeys: List<Byte> = emptyList()): ByteArray {
+        val keys = (pressedKeys + extraKeys).take(MAX_KEYS)
+        val effectiveModifiers =
+            if (isCapsLockOn && keys.any { it.toInt() in LETTER_USAGE_RANGE }) {
+                modifierMask or KeyboardKey.KEY_SHIFT_LEFT.byte.toInt()
+            } else {
+                modifierMask
+            }
+
+        return byteArrayOf(
+            effectiveModifiers.toByte(),
+            0,
+            keys.getOrElse(0) { 0 },
+            keys.getOrElse(1) { 0 },
+            keys.getOrElse(2) { 0 },
+            keys.getOrElse(3) { 0 },
+            keys.getOrElse(4) { 0 },
+            keys.getOrElse(5) { 0 }
+        )
+    }
+
+    private companion object {
+        const val REPORT_SIZE = 8
+        const val MAX_KEYS = 6
+        val LETTER_USAGE_RANGE = 0x04..0x1D
+    }
+}
diff --git a/app/src/test/java/com/atharok/btremote/domain/entities/remoteInput/keyboard/KeyboardReportStateTest.kt b/app/src/test/java/com/atharok/btremote/domain/entities/remoteInput/keyboard/KeyboardReportStateTest.kt
new file mode 100644
index 0000000..55425cc
